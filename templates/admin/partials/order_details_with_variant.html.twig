<table>
    <thead>
        <tr>
            <th>Produit</th>
            <th>Quantité-- |</th>
            <th>--Couleur-- |</th>
            <th>--Taille-- |</th>
            <th>--Prix Unitaire TTC--</th>
        </tr>
    </thead>
    <tbody>
        {% for detail in field.value %}
        <tr>
            <td class='text-center'>
                {{ detail.productName|length > 50 
                    ? detail.productName|slice(0, 50) ~ '...' 
                    : detail.productName 
                }}
            </td>
            <td class='text-center text-danger'>{{ detail.quantity }}</td>
            <td class='text-center'>{{ detail.variant.color}}</td>
            <td class='text-center'>
                {{ detail.selectedSize}}
            </td>
            <td class='text-center'>
                {% set discountedPrice = detail.variant.price * (1 - (detail.variant.offVariant / 100)) %}
                {{ discountedPrice | number_format(2, '.', ',') }} €
            </td>

        </tr>
        {% endfor %}
    </tbody>
</table>
