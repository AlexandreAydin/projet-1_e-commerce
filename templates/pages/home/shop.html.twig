document.addEventListener('DOMContentLoaded', () => {
    const categoriesCheckboxes = document.querySelectorAll('.js-categories-container input[type="checkbox"]');
    const subcategoryCache = {}; // Cache pour éviter les requêtes répétées

    /**
     * Ajoute les sous-catégories dynamiquement sous leurs catégories parentes.
     * @param {Array} data - Liste des sous-catégories.
     * @param {String} categoryId - ID de la catégorie parente.
     */
    const renderSubcategories = (data, categoryId) => {
        const categoryElement = document.querySelector(`.js-categories-container input[value="${categoryId}"]`);
        if (!categoryElement) {
            console.error(`Category with ID ${categoryId} not found.`);
            return;
        }

        const parentDiv = categoryElement.closest('div');
        let subcategoryDiv = parentDiv.querySelector('.subcategory-list');
        if (!subcategoryDiv) {
            subcategoryDiv = document.createElement('div');
            subcategoryDiv.classList.add('subcategory-list');
            parentDiv.appendChild(subcategoryDiv);
        }

        subcategoryDiv.innerHTML = ''; // Vide les anciennes sous-catégories

        data.forEach((subCategory) => {
            const subcategoryItem = document.createElement('div');
            subcategoryItem.classList.add('subcategory-item');

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.name = 'search_product[subCategories][]'; // Nom attendu par Symfony
            checkbox.value = subCategory.id;
            checkbox.id = `search_product_subCategories_${subCategory.id}`; // ID formaté attendu
            checkbox.classList.add('form-check-input'); // Classe pour le style

            // Cochez si la sous-catégorie est déjà cochée
            if (document.querySelector(`.js-subcategories-container input[value="${subCategory.id}"]:checked`)) {
                checkbox.checked = true;
            }

            const label = document.createElement('label');
            label.textContent = subCategory.name;
            label.setAttribute('for', `search_product_subCategories_${subCategory.id}`);
            label.classList.add('form-check-label');

            subcategoryItem.appendChild(checkbox);
            subcategoryItem.appendChild(label);
            subcategoryDiv.appendChild(subcategoryItem);
        });
    };

    /**
     * Met à jour les sous-catégories envoyées en fonction de l'état actuel des cases cochées.
     */
    const updateSubcategories = () => {
        const subcategoriesForm = document.querySelector('.js-subcategories-container');
        const checkedSubcategories = document.querySelectorAll('.subcategory-list input:checked');

        // Supprime les sous-catégories précédemment sélectionnées
        subcategoriesForm.innerHTML = '';

        // Ajoute les sous-catégories actuellement cochées
        checkedSubcategories.forEach((checkbox) => {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'search_product[subCategories][]';
            hiddenInput.value = checkbox.value;
            subcategoriesForm.appendChild(hiddenInput);
        });
    };

    /**
     * Récupère les sous-catégories depuis le serveur ou utilise le cache.
     * @param {String} categoryId - ID de la catégorie.
     */
    const fetchAndDisplaySubcategories = async (categoryId) => {
        if (subcategoryCache[categoryId]) {
            renderSubcategories(subcategoryCache[categoryId], categoryId); // Utilise le cache
            updateSubcategories(); // Met à jour les sous-catégories dans le formulaire
            return;
        }

        try {
            const response = await fetch('/get-subcategories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ categories: [categoryId] }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch subcategories');
            }

            const data = await response.json();
            subcategoryCache[categoryId] = data; // Met en cache les sous-catégories
            renderSubcategories(data, categoryId);
            updateSubcategories(); // Met à jour les sous-catégories dans le formulaire
        } catch (error) {
            console.error('Error fetching subcategories:', error);
        }
    };

    /**
     * Gère les changements sur les catégories.
     * @param {Event} event - L'événement déclenché.
     */
    const handleCategoryChange = (event) => {
        const categoryId = event.target.value;
        if (event.target.checked) {
            fetchAndDisplaySubcategories(categoryId); // Charge et affiche les sous-catégories
        } else {
            // Retire les sous-catégories si la catégorie est décochée
            const parentDiv = event.target.closest('div');
            const subcategoryDiv = parentDiv.querySelector('.subcategory-list');
            if (subcategoryDiv) {
                subcategoryDiv.remove();
            }
            updateSubcategories(); // Met à jour les sous-catégories dans le formulaire
        }
    };

    // Initialise les sous-catégories pour les catégories déjà cochées
    categoriesCheckboxes.forEach((checkbox) => {
        if (checkbox.checked) {
            fetchAndDisplaySubcategories(checkbox.value);
        }
        checkbox.addEventListener('change', handleCategoryChange);
    });

    // Écoute les changements sur les sous-catégories
    document.addEventListener('change', (event) => {
        if (event.target.closest('.subcategory-list')) {
            updateSubcategories(); // Met à jour les sous-catégories dans le formulaire
        }
    });
});



document.addEventListener('DOMContentLoaded', () => {
    const brandsCheckboxes = document.querySelectorAll('.productBrand input[type="checkbox"]');
    const modelCache = {}; // Cache pour éviter les requêtes répétées

    /**
     * Ajoute les modèles dynamiquement sous leurs marques parentes.
     * @param {Array} data - Liste des modèles.
     * @param {String} brandId - ID de la marque parente.
     */
    const renderModels = (data, brandId) => {
        const brandElement = document.querySelector(`.productBrand input[value="${brandId}"]`);
        if (!brandElement) {
            console.error(`Brand with ID ${brandId} not found.`);
            return;
        }

        const parentDiv = brandElement.closest('div');
        let modelDiv = parentDiv.querySelector('.model-list');
        if (!modelDiv) {
            modelDiv = document.createElement('div');
            modelDiv.classList.add('model-list');
            parentDiv.appendChild(modelDiv);
        }

        modelDiv.innerHTML = ''; // Vide les anciens modèles

        data.forEach((model) => {
            const modelItem = document.createElement('div');
            modelItem.classList.add('model-item');

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.name = 'search_product[brandModel][]'; // Nom attendu par Symfony
            checkbox.value = model.id;
            checkbox.id = `search_product_brandModel_${model.id}`; // ID formaté attendu
            checkbox.classList.add('form-check-input'); // Classe pour le style

            // Cochez si le modèle est déjà sélectionné
            if (document.querySelector(`.js-brandModel-container input[value="${model.id}"]:checked`)) {
                checkbox.checked = true;
            }

            const label = document.createElement('label');
            label.textContent = model.name;
            label.setAttribute('for', `search_product_brandModel_${model.id}`);
            label.classList.add('form-check-label');

            modelItem.appendChild(checkbox);
            modelItem.appendChild(label);
            modelDiv.appendChild(modelItem);
        });
    };

    /**
     * Met à jour les modèles envoyés en fonction de l'état actuel des cases cochées.
     */
    const updateModels = () => {
        const modelsForm = document.querySelector('.js-brandModel-container');
        const checkedModels = document.querySelectorAll('.model-list input:checked');

        // Supprime les modèles précédemment sélectionnés
        modelsForm.innerHTML = '';

        // Ajoute les modèles actuellement cochés
        checkedModels.forEach((checkbox) => {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'search_product[brandModel][]';
            hiddenInput.value = checkbox.value;
            modelsForm.appendChild(hiddenInput);
        });
    };

    /**
     * Récupère les modèles depuis le serveur ou utilise le cache.
     * @param {String} brandId - ID de la marque.
     */
    const fetchAndDisplayModels = async (brandId) => {
        if (modelCache[brandId]) {
            renderModels(modelCache[brandId], brandId); // Utilise le cache
            updateModels(); // Met à jour les modèles dans le formulaire
            return;
        }

        try {
            const response = await fetch('/get-brandModel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productBrand: [brandId] }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch models');
            }

            const data = await response.json();
            modelCache[brandId] = data; // Met en cache les modèles
            renderModels(data, brandId);
            updateModels(); // Met à jour les modèles dans le formulaire
        } catch (error) {
            console.error('Error fetching models:', error);
        }
    };

    /**
     * Gère les changements sur les marques.
     * @param {Event} event - L'événement déclenché.
     */
    const handleBrandChange = (event) => {
        const brandId = event.target.value;
        if (event.target.checked) {
            fetchAndDisplayModels(brandId); // Charge et affiche les modèles
        } else {
            // Retire les modèles si la marque est décochée
            const parentDiv = event.target.closest('div');
            const modelDiv = parentDiv.querySelector('.model-list');
            if (modelDiv) {
                modelDiv.remove();
            }
            updateModels(); // Met à jour les modèles dans le formulaire
        }
    };

    // Initialise les modèles pour les marques déjà cochées
    brandsCheckboxes.forEach((checkbox) => {
        if (checkbox.checked) {
            fetchAndDisplayModels(checkbox.value);
        }
        checkbox.addEventListener('change', handleBrandChange);
    });

    // Écoute les changements sur les modèles
    document.addEventListener('change', (event) => {
        if (event.target.closest('.model-list')) {
            updateModels(); // Met à jour les modèles dans le formulaire
        }
    });
});





</script>




