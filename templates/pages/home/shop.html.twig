{# document.addEventListener('DOMContentLoaded', () => {
    const categoriesCheckboxes = document.querySelectorAll('.js-categories-container input[type="checkbox"]');
    const subCategoriesContainer = document.querySelector('.js-subcategories-container');
    const subcategoryCache = {}; // Cache simple pour les sous-catégories

    if (!subCategoriesContainer) {
        console.error('Subcategories container not found!');
        return;
    }

    /**
     * Affiche les sous-catégories dans le conteneur
     * @param {Array} data - Liste des sous-catégories à afficher
     */
    const renderSubcategories = (data) => {
        subCategoriesContainer.innerHTML = ''; // Vide le conteneur avant d'ajouter des données
        data.forEach(subCategory => {
            const div = document.createElement('div');
            div.classList.add('subcategory-item');

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.name = 'subCategories[]';
            checkbox.value = subCategory.id;

            const label = document.createElement('label');
            label.textContent = subCategory.name;

            div.appendChild(checkbox);
            div.appendChild(label);
            subCategoriesContainer.appendChild(div);
        });
    };

    /**
     * Récupère les sous-catégories depuis le serveur ou le cache
     * @param {Array} selectedCategories - Liste des catégories sélectionnées
     */
    const fetchAndDisplaySubcategories = async (selectedCategories) => {
        const cacheKey = selectedCategories.sort().join(','); // Génère une clé unique pour le cache
        if (subcategoryCache[cacheKey]) {
            renderSubcategories(subcategoryCache[cacheKey]); // Utilise les données du cache si disponibles
            return;
        }

        try {
            const response = await fetch('/get-subcategories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ categories: selectedCategories })
            });

            if (!response.ok) {
                throw new Error('Failed to fetch subcategories');
            }

            const data = await response.json();
            subcategoryCache[cacheKey] = data; // Ajoute les données au cache
            renderSubcategories(data); // Rendu dynamique
        } catch (error) {
            console.error('Error fetching subcategories:', error);
        }
    };

    /**
     * Gestion des catégories sélectionnées
     */
    const handleCategoryChange = () => {
        const selectedCategories = Array.from(categoriesCheckboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);

        if (selectedCategories.length > 0) {
            fetchAndDisplaySubcategories(selectedCategories);
        } else {
            subCategoriesContainer.innerHTML = ''; // Vide le conteneur si aucune catégorie n'est sélectionnée
        }
    };

    // Vérifie les catégories déjà sélectionnées au chargement
    const initialSelectedCategories = Array.from(categoriesCheckboxes)
        .filter(cb => cb.checked)
        .map(cb => cb.value);

    if (initialSelectedCategories.length > 0) {
        fetchAndDisplaySubcategories(initialSelectedCategories); // Charge les sous-catégories initiales
    }

    // Ajoute un écouteur pour détecter les changements sur les cases à cocher
    categoriesCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', handleCategoryChange);
    });
}); #}


