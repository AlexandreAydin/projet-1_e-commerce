{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
   <style>

/* Titres des catégories */
.category-title {
    font-weight: bold;
    margin-bottom: 10px;
}

/* Sous-catégories */
.subcategory-list {
    margin-left: 20px;
}

/* Items de sous-catégorie */
.subcategory-item {
    margin-top: 7px;
}

.form-check {
    border: none;
    margin-top: 0;
    margin-bottom: 0;
    padding-top:0;
}

.col-form-label{
    display:none;
}


/* Ajoute un espace entre la checkbox et le texte */
.subcategory-item input[type="checkbox"] {
    margin-right: 8px; /* Espace entre la checkbox et le label */
}

.model-list {
    margin-left: 20px;
}



.hidden-focus {
    visibility: hidden;
    position: absolute;
    opacity: 0;
}


input[type="number"]::-webkit-inner-spin-button,
input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

input[type="number"] {
    -moz-appearance: textfield; /* Pour Firefox */
}


</style>

    <div class="">
        <div class="m-4">
            <div class="row flex-column flex-lg-row-reverse">
                <div class="col-lg-8 order-2 order-lg-1 w-100">
                    <div class="row shop_container">
                        {% if not products %}
                            <p>Désolé, aucun produit ne correspond au résultat de votre recherche.</p>
                        {% else %}
                            {% for product in products %}
                                {% include "partials/_product.html.twig" with {'product':product} %}
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
                <div class="col-lg-2 order-1 order-lg-2 mt-4 pt-2 mt-lg-0 pt-lg-0 w-100">
                    <div class="sidebar">
                        <form action="{{ path('app_shop') }}" method="get">
                            {{ form_start(search) }}
                            <input type="hidden" name="query" id="query-input" placeholder="Rechercher des produits..." value="{{ app.request.query.get('query') }}">
                           
                            <div class=" position-relative w-100 mb-4">
                                <input 
                                    type="text" 
                                    name="query" 
                                    class="form-control rounded-pill" 
                                    placeholder="Rechercher..." 
                                    value="{{ app.request.query.get('query') }}" 
                                    style="padding-left: 2rem; border: 0.5px solid gray; font-size: 0.8rem; height: 35px;" 
                                    >
                                <i  class="fa-solid  fa-magnifying-glass position-absolute" style="left: 10px; top: 50%; transform: translateY(-50%); color: #6c757d; font-size: 0.9rem;"></i>
                            </div>
                          
                            <h4 class="widget_title">Filtrage</h4>
                            <h5 class="widget_title">Categories</h5>
                            <div class="scrollable-checkbox js-categories-container">
                                {{ form_row(search.categories) }}
                            </div>
                            <div class="scrollable-checkbox js-subcategories-container d-none">
                                {{ form_row(search.subCategories) }}
                            </div>
                            <div class="widget">
                                <div class="form-row">
                                    <div class="col-md-6">
                                        {{ form_row(search.minPrice) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(search.maxPrice) }}
                                    </div>
                                </div>
                            </div>
                            <h5 class="widget_title">Marque et Model</h5>
                            <div class="scrollable-checkbox productBrand">
                                {{ form_row(search.productBrand) }}
                            </div>
                            <div class="scrollable-checkbox js-brandModel-container d-none">
                                {{ form_row(search.brandModel) }}
                            </div>

                            <button type="submit" class="btn btn-border-fill btn-block mb-4">Rechercher</button>
                            {{ form_end(search) }}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# Permet d'affiché uniqument sous categorie et model du produit qui existe avec js   #}
    {% for product in products %}
        <div class="product-card" class="d-non"
            data-id="{{ product.id }}" 
            data-subcategory-id="{{ product.subCategorie ? product.subCategorie.id : '' }}" data-brandModel-id="{{ product.brandModel.id }}">
        </div>
    {% endfor %}





<script>

// affiches les produit uniqument pour 
document.addEventListener('DOMContentLoaded', () => {
    /*** VARIABLES GLOBALES ***/
    const categoriesCheckboxes = document.querySelectorAll('.js-categories-container input[type="checkbox"]');
    const subcategoryCache = {}; // Cache pour éviter des requêtes inutiles

    /**
     * Vérifie que les produits affichés ont bien `data-subcategory-id`
     * et récupère uniquement les sous-catégories des produits visibles
     */
    const getVisibleSubcategories = () => {
        const visibleProducts = document.querySelectorAll('.product-card');

        if (visibleProducts.length === 0) {
            console.warn(`⚠️ Aucun produit visible trouvé ! Vérifie que les produits existent dans le HTML.`);
            return [];
        }

        const subcategoryIds = new Set();

        //console.log(`📢 Produits détectés sur la page:`, visibleProducts);

        visibleProducts.forEach(product => {
            const subcategoryId = product.getAttribute('data-subcategory-id');

            if (subcategoryId) {
                subcategoryIds.add(parseInt(subcategoryId));
                //console.log(`🔍 Produit ID=${product.getAttribute('data-id')} → Sous-catégorie=${subcategoryId}`);
            } else {
                console.warn(`⚠️ Le produit ${product.getAttribute('data-id')} n'a pas de sous-catégorie.`);
            }
        });

        //console.log(`✅ Sous-catégories réellement utilisées par les produits visibles:`, Array.from(subcategoryIds));
        return Array.from(subcategoryIds);
    };



    /**
     * Récupère les sous-catégories et affiche uniquement celles liées aux produits visibles
     * @param {String} categoryId - ID de la catégorie
     */
    const fetchAndDisplaySubcategories = async (categoryId) => {
        //console.log(`🔄 Récupération des sous-catégories pour la catégorie ${categoryId}`);

        try {
            const response = await fetch('/get-subcategories', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ categories: [categoryId] }),
            });

            if (!response.ok) throw new Error('❌ Erreur lors de la récupération des sous-catégories');

            const data = await response.json();
            //console.log(`✅ Sous-catégories reçues pour la catégorie ${categoryId}:`, data);

            // Vérifie quelles sous-catégories sont réellement utilisées
            const validSubcategories = getVisibleSubcategories();
            if (validSubcategories.length === 0) {
                console.warn(`⚠️ Aucune sous-catégorie visible trouvée après filtrage.`);
            }

            const filteredData = data.filter(subCategory => validSubcategories.includes(subCategory.id));

            //console.log(`📌 Sous-catégories après filtrage :`, filteredData);

            renderSubcategories(filteredData, categoryId);
            updateSubcategories();
        } catch (error) {
            console.error('❌ Erreur lors de la récupération des sous-catégories:', error);
        }
    };

    /**
     * Affiche dynamiquement les sous-catégories sous leurs catégories parentes
     * @param {Array} data - Liste des sous-catégories valides
     * @param {String} categoryId - ID de la catégorie
     */
    const renderSubcategories = (data, categoryId) => {
        //console.log(`🛠 Ajout des sous-catégories pour la catégorie ${categoryId}:`, data);

        const categoryElement = document.querySelector(`.js-categories-container input[value="${categoryId}"]`);
        if (!categoryElement) {
            console.warn(`⚠️ Catégorie ${categoryId} introuvable dans le DOM`);
            return;
        }

        const parentDiv = categoryElement.closest('.form-check');
        let subcategoryDiv = parentDiv.querySelector('.subcategory-list');

        if (!subcategoryDiv) {
            subcategoryDiv = document.createElement('div');
            subcategoryDiv.classList.add('subcategory-list');
            parentDiv.appendChild(subcategoryDiv);
        }

        const validSubcategories = getVisibleSubcategories();
        //console.log(`🔍 Sous-catégories visibles sur la page:`, validSubcategories);

        //console.log(`📌 Sous-catégories AVANT filtrage :`, data);

        const filteredData = data.filter(subCategory => validSubcategories.includes(subCategory.id));
        //console.log(`📌 Sous-catégories APRÈS filtrage :`, filteredData);

        subcategoryDiv.innerHTML = '';

        if (filteredData.length === 0) {
            console.warn(`⚠️ Aucune sous-catégorie à afficher pour la catégorie ${categoryId}.`);
            return;
        }

        filteredData.forEach((subCategory) => {
            //console.log(`➕ Ajout de la sous-catégorie ${subCategory.name}`);

            const subcategoryItem = document.createElement('div');
            subcategoryItem.classList.add('subcategory-item');

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.name = 'search_product[subCategories][]';
            checkbox.value = subCategory.id;
            checkbox.id = `search_product_subCategories_${subCategory.id}`;
            checkbox.classList.add('form-check-input');

            const label = document.createElement('label');
            label.textContent = subCategory.name;
            label.setAttribute('for', `search_product_subCategories_${subCategory.id}`);
            label.classList.add('form-check-label');

            subcategoryItem.appendChild(checkbox);
            subcategoryItem.appendChild(label);
            subcategoryDiv.appendChild(subcategoryItem);
        });

        //console.log(`✅ Sous-catégories affichées pour la catégorie ${categoryId}`);
    };



    /**
     * Met à jour les sous-catégories sélectionnées dans le formulaire
     */
    const updateSubcategories = () => {
        const subcategoriesForm = document.querySelector('.js-subcategories-container');
        if (!subcategoriesForm) return;

        subcategoriesForm.innerHTML = '';

        document.querySelectorAll('.subcategory-list input:checked').forEach((checkbox) => {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'search_product[subCategories][]';
            hiddenInput.value = checkbox.value;
            subcategoriesForm.appendChild(hiddenInput);
        });
    };

    /**
     * Gère les changements de sélection des catégories
     */
    const handleCategoryChange = (event) => {
        const categoryId = event.target.value;
        if (event.target.checked) {
            fetchAndDisplaySubcategories(categoryId);
        } else {
            event.target.closest('div').querySelector('.subcategory-list')?.remove();
            updateSubcategories();
        }
    };

    // Initialisation : Vérifie quelles catégories sont déjà cochées
    categoriesCheckboxes.forEach((checkbox) => {
        if (checkbox.checked) fetchAndDisplaySubcategories(checkbox.value);
        checkbox.addEventListener('change', handleCategoryChange);
    });
});


document.addEventListener('DOMContentLoaded', () => {
    /*** VARIABLES GLOBALES ***/
    const brandsCheckboxes = document.querySelectorAll('.productBrand input[type="checkbox"]');
    const modelCache = {}; // Cache pour éviter des requêtes inutiles

    /**
     * Vérifie que les produits affichés contiennent bien `data-brandModel-id`
     * et récupère uniquement les modèles des marques visibles
     */
    const getVisibleModels = () => {
        const visibleProducts = document.querySelectorAll('.product-card'); // Vérifie bien ce sélecteur

        if (visibleProducts.length === 0) {
            console.warn(`⚠️ Aucun produit visible trouvé ! Vérifie que les produits existent dans le HTML.`);
            return [];
        }

        const modelIds = new Set();

        //console.log(`📢 Produits détectés sur la page:`, visibleProducts);

        visibleProducts.forEach(product => {
            const productId = product.getAttribute('data-id');
            const modelId = product.getAttribute('data-brandModel-id');

            if (modelId) {
                modelIds.add(parseInt(modelId));
                //console.log(`🔍 Produit ID=${productId} → Modèle=${modelId}`);
            } else {
                console.warn(`⚠️ Le produit ID=${productId} n'a pas de modèle.`);
            }
        });

        //console.log(`✅ Modèles réellement utilisés par les produits visibles:`, Array.from(modelIds));
        return Array.from(modelIds);
    };

    /**
     * Récupère les modèles et affiche uniquement ceux liés aux marques visibles
     * @param {String} brandId - ID de la marque
     */
    const fetchAndDisplayModels = async (brandId) => {
        //console.log(`🔄 Récupération des modèles pour la marque ${brandId}`);

        try {
            const response = await fetch('/get-brandModel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productBrand: [brandId] }),
            });

            if (!response.ok) throw new Error('❌ Erreur lors de la récupération des modèles');

            const data = await response.json();
            //console.log(`✅ Modèles reçus pour la marque ${brandId}:`, data);

            // Vérifie quels modèles sont réellement utilisés
            const validModels = getVisibleModels();
            if (validModels.length === 0) {
                console.warn(`⚠️ Aucun modèle visible trouvé après filtrage.`);
            }

            const filteredData = data.filter(model => validModels.includes(model.id));

            //console.log(`📌 Modèles après filtrage :`, filteredData);

            renderModels(filteredData, brandId);
            updateModels();
        } catch (error) {
            console.error('❌ Erreur lors de la récupération des modèles:', error);
        }
    };

    /**
     * Affiche dynamiquement les modèles sous leurs marques parentes
     * @param {Array} data - Liste des modèles valides
     * @param {String} brandId - ID de la marque
     */
    const renderModels = (data, brandId) => {
        //console.log(`🛠 Ajout des modèles pour la marque ${brandId}:`, data);

        const brandElement = document.querySelector(`.productBrand input[value="${brandId}"]`);
        if (!brandElement) {
            console.warn(`⚠️ Marque ${brandId} introuvable dans le DOM`);
            return;
        }

        const parentDiv = brandElement.closest('.form-check');
        let modelDiv = parentDiv.querySelector('.model-list');

        if (!modelDiv) {
            console.warn(`⚠️ .model-list introuvable pour la marque ${brandId}, création...`);
            modelDiv = document.createElement('div');
            modelDiv.classList.add('model-list');
            parentDiv.appendChild(modelDiv);
        }

        // Vérifie quels modèles sont visibles avant filtrage
        const validModels = getVisibleModels();
        //console.log(`🔍 Modèles visibles sur la page:`, validModels);

        //console.log(`📌 Modèles AVANT filtrage :`, data);

        const filteredData = data.filter(model => validModels.includes(model.id));
        //console.log(`📌 Modèles APRÈS filtrage :`, filteredData);

        // Effacer les modèles obsolètes
        modelDiv.innerHTML = '';

        if (filteredData.length === 0) {
            console.warn(`⚠️ Aucun modèle à afficher pour la marque ${brandId}.`);
            return;
        }

        // ✅ Ajouter uniquement les modèles valides
        filteredData.forEach((model) => {
            //console.log(`➕ Ajout du modèle ${model.name}`);

            const modelItem = document.createElement('div');
            modelItem.classList.add('model-item');

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.name = 'search_product[brandModel][]';
            checkbox.value = model.id;
            checkbox.id = `search_product_brandModel_${model.id}`;
            checkbox.classList.add('form-check-input');

            const label = document.createElement('label');
            label.textContent = model.name;
            label.setAttribute('for', `search_product_brandModel_${model.id}`);
            label.classList.add('form-check-label');

            modelItem.appendChild(checkbox);
            modelItem.appendChild(label);
            modelDiv.appendChild(modelItem);
        });

        //console.log(`✅ Modèles affichés pour la marque ${brandId}`);
    };

    /**
     * Met à jour les modèles sélectionnés dans le formulaire
     */
    const updateModels = () => {
        const modelsForm = document.querySelector('.js-brandModel-container');
        if (!modelsForm) return;

        modelsForm.innerHTML = '';

        document.querySelectorAll('.model-list input:checked').forEach((checkbox) => {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'search_product[brandModel][]';
            hiddenInput.value = checkbox.value;
            modelsForm.appendChild(hiddenInput);
        });
    };

    /**
     * Gère les changements de sélection des marques
     */
    const handleBrandChange = (event) => {
        const brandId = event.target.value;
        if (event.target.checked) {
            fetchAndDisplayModels(brandId);
        } else {
            event.target.closest('div').querySelector('.model-list')?.remove();
            updateModels();
        }
    };

    // Initialisation : Vérifie quelles marques sont déjà cochées
    brandsCheckboxes.forEach((checkbox) => {
        if (checkbox.checked) fetchAndDisplayModels(checkbox.value);
        checkbox.addEventListener('change', handleBrandChange);
    });
});


</script>




{% endblock %}
