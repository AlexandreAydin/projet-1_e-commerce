        });
        {# Voir + et voir moins end  #}


        document.addEventListener("DOMContentLoaded", function () {
            document.querySelector(".rating_wrap").addEventListener("click", function (event) {
                event.preventDefault();
                let reviewTab = document.querySelector("#Reviews-tab");
                if (reviewTab) { reviewTab.click(); }
                let reviewSection = document.querySelector("#Reviews");
                if (reviewSection) {
                    setTimeout(() => {
                        reviewSection.scrollIntoView({ behavior: "smooth", block: "start" });
                    }, 300);
                }
            });
        });


        (function() {
            function initElevateZoom() {
                $('#main_product_imgs').elevateZoom({ zoomType: "inner", cursor: "crosshair" });
                {% for image in product.images %}
                $('#thumbnails_{{ loop.index }}').elevateZoom({ zoomType: "inner", cursor: "crosshair" });
                {% endfor %}
            }
            function changeMainImage(thumbnail) {
                const mainImage = $('#main_product_img');
                const largeSrc = thumbnail.getAttribute('data-large-src');
                mainImage.attr('src', largeSrc);
                mainImage.data('zoom-image', largeSrc);
                mainImage.removeData('elevateZoom');
                $('.zoomContainer').remove();
                initElevateZoom();
            }
            $(window).on('load', initElevateZoom);

            function handleStarRating() {
                const stars = document.querySelectorAll(".star_rating span");
                stars.forEach(star => {
                    star.addEventListener('click', function(e) {
                        const value = e.currentTarget.getAttribute('data-value');
                        document.getElementById('rewiews_product_note').value = value;
                        highlightStars(value);
                    });
                });
            }
            function highlightStars(value) {
                const stars = document.querySelectorAll(".star_rating span i");
                stars.forEach((star, index) => {
                    if (index < value) { star.classList.remove("far"); star.classList.add("fas"); }
                    else { star.classList.remove("fas"); star.classList.add("far"); }
                });
            }
            document.addEventListener("DOMContentLoaded", function() { handleStarRating(); });
        })();


        document.addEventListener('DOMContentLoaded', function() {
            const colorSelect = document.getElementById('color');
            const sizeSelect = document.getElementById('size');
            const variants = {{ product.variants|json_encode()|raw }};

            function updateSizes() {
                const selectedColor = colorSelect.value;
                Array.from(sizeSelect.options).forEach(option => {
                    option.disabled = false;
                    option.hidden = false;
                });
                Array.from(sizeSelect.options).forEach(option => {
                    const optionColor = option.getAttribute('data-color');
                    if (optionColor !== selectedColor) {
                        option.disabled = true;
                        option.hidden = true;
                    }
                });
                const firstAvailableOption = Array.from(sizeSelect.options).find(option => !option.disabled);
                if (firstAvailableOption) { firstAvailableOption.selected = true; }
            }

            colorSelect.addEventListener('change', updateSizes);
            updateSizes();
        });


        {# === SWATCHES COULEUR — gestion des clics === #}
        document.addEventListener('DOMContentLoaded', function () {
            const colorSelect = document.getElementById('color');
            const colorNameLabel = document.getElementById('selected-color-name');

            document.querySelectorAll('.color-swatch-circle').forEach(function (swatch) {
                swatch.addEventListener('click', function () {
                    const color = this.getAttribute('data-color');

                    // Met à jour le select caché → déclenche toute la logique JS existante
                    colorSelect.value = color;
                    colorSelect.dispatchEvent(new Event('change'));

                    // Met à jour le label
                    if (colorNameLabel) colorNameLabel.textContent = color;

                    // Retire l'état actif de tous les swatches
                    document.querySelectorAll('.color-swatch-circle').forEach(function (s) {
                        s.style.border      = '2px solid #ddd';
                        s.style.boxShadow   = 'none';
                    });

                    // Active le swatch cliqué
                    this.style.border     = '2px solid #C8A96E';
                    this.style.boxShadow  = '0 0 0 2px #fff, 0 0 0 4px #C8A96E';
                });
            });
        });


        {# === PILLS TAILLE — gestion des clics + refresh quand couleur change === #}
        document.addEventListener('DOMContentLoaded', function () {
            const sizeSelect    = document.getElementById('size');
            const colorSelect   = document.getElementById('color');
            const sizeName      = document.getElementById('selected-size-name');
            const pillContainer = document.getElementById('size-pills-container');

            // ── Active une pill et sync le select caché ─────────────────────
            function activatePill(pill) {
                if (!pill || pill.dataset.outOfStock === '1') return;

                // Reset toutes les pills
                pillContainer.querySelectorAll('.size-pill').forEach(p => {
                    p.style.border     = '2px solid #ddd';
                    p.style.background = '#fff';
                    p.style.color      = '#333';
                });

                // Active la pill cliquée
                pill.style.border     = '2px solid #C8A96E';
                pill.style.background = '#C8A96E';
                pill.style.color      = '#fff';

                // Sync select caché → déclenche tout le JS existant (stock, prix, images)
                sizeSelect.value = pill.dataset.size;
                sizeSelect.dispatchEvent(new Event('change'));

                // Met à jour le label
                if (sizeName) sizeName.textContent = pill.dataset.size;
            }

            // ── Rebuild les pills visibles quand la couleur change ───────────
            function refreshPillsForColor(selectedColor) {
                const allPills = pillContainer.querySelectorAll('.size-pill');
                let firstVisible = null;

                allPills.forEach(pill => {
                    const pillColor = pill.dataset.color;
                    if (pillColor === selectedColor) {
                        pill.style.display = 'inline-flex';
                        if (!firstVisible) firstVisible = pill;
                    } else {
                        pill.style.display = 'none';
                        // Reset style des pills cachées
                        pill.style.border     = '2px solid #ddd';
                        pill.style.background = '#fff';
                        pill.style.color      = '#333';
                    }
                });

                // Active automatiquement la première taille disponible
                if (firstVisible) activatePill(firstVisible);
            }

            // ── Listeners clics sur les pills ────────────────────────────────
            pillContainer.querySelectorAll('.size-pill').forEach(pill => {
                pill.addEventListener('click', function () {
                    activatePill(this);
                });
            });

            // ── Quand la couleur change → on filtre les pills ────────────────
            if (colorSelect) {
                colorSelect.addEventListener('change', function () {
                    refreshPillsForColor(this.value);
                });
                // Init au chargement
                refreshPillsForColor(colorSelect.value);
            } else {
                // Pas de couleur → active juste la première pill
                const firstPill = pillContainer.querySelector('.size-pill:not([data-out-of-stock="1"])');
                if (firstPill) activatePill(firstPill);
            }
        });


        document.addEventListener('DOMContentLoaded', function() {
            const sizeSelect = document.getElementById('size');
            const colorSelect = document.getElementById('color');
            const priceDisplay = document.getElementById('variant-price');
            const variantImages = document.querySelectorAll('.product-variant-image');
            let variants = {{ variants|json_encode()|raw }};

            function getVariantBySizeAndColor(size, color) {
                if (!Array.isArray(variants) || variants.length === 0) { return null; }
                return variants.find(variant => {
                    const sizeArray = Array.isArray(variant.sizes) ? variant.sizes : [];
                    return variant.color === color && sizeArray.includes(size);
                });
            }

            function updatePrice() {
                const selectedVariant = getVariantBySizeAndColor(sizeSelect.value, colorSelect.value);
                if (selectedVariant) { priceDisplay.textContent = `${selectedVariant.price} €`; }
                else { priceDisplay.textContent = 'Prix indisponible'; }
            }

            function updateVariantImages() {
                const selectedVariant = getVariantBySizeAndColor(sizeSelect.value, colorSelect.value);
                if (selectedVariant) {
                    variantImages.forEach(image => {
                        image.style.display = 'none';
                        if (image.getAttribute('data-variant-id') === String(selectedVariant.id)) {
                            image.style.display = 'block';
                        }
                    });
                }
            }

            sizeSelect.addEventListener('change', updateVariantImages);
            colorSelect.addEventListener('change', updateVariantImages);
            sizeSelect.addEventListener('change', updatePrice);
            colorSelect.addEventListener('change', updatePrice);
            updatePrice();
            updateVariantImages();
        });


        document.addEventListener('DOMContentLoaded', function() {
