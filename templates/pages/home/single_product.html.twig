                        thumbnail.classList.add('mb-3', 'mx-2');
                        let thumbnailSrc = video.thumbnailName ? `/images/products/${video.thumbnailName}` : `/images/products/${video.imageName.replace(/\.(mp4|webm)$/i, '.jpg')}`;
                        thumbnail.innerHTML = `<div class="thumbnail_img_box" style="width: 60px; height: 60px; position: relative; background-color: #000;"><a href="/images/products/${video.imageName}" data-fancybox="product-images" data-fancybox-index="${images.length}" data-type="video" title="Vidéo" data-large-src="${thumbnailSrc}"><div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10;"><svg width="30" height="30" viewBox="0 0 24 24" fill="white" style="opacity: 0.8;"><polygon points="5,3 19,12 5,21" /></svg></div></a></div>`;
                        thumbnailsContainer.appendChild(thumbnail);
                    }

                    if (typeof Fancybox !== 'undefined') {
                        Fancybox.bind('[data-fancybox="product-images"]', { groupAll: true, startIndex: 0 });
