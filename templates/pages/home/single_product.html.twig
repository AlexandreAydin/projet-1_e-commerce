    <script>

        {# Voir + et voir moins start  #}
        document.addEventListener('DOMContentLoaded', () => {
            const toggleMore = document.querySelector('.toggle-more');
            const toggleLess = document.querySelector('.toggle-less');
            const moreInfoContent = document.querySelector('.more-info-content');

            if (toggleMore && toggleLess && moreInfoContent) {
                toggleMore.addEventListener('click', () => {
                    moreInfoContent.style.display = 'block';
                    toggleMore.parentElement.style.display = 'none';
                });

                toggleLess.addEventListener('click', () => {
                    moreInfoContent.style.display = 'none';
                    toggleMore.parentElement.style.display = 'block';
                });
