        document.addEventListener('DOMContentLoaded', function () {
            const sizeSelect = document.getElementById('size');
            const colorSelect = document.getElementById('color');
            const quantityInput = document.getElementById('quantity');
            const incrementButton = document.querySelector('.plus');
            const decreaseButton = document.querySelector('.minus');
            const addToCartContainer = document.querySelector('.cart_btn');
            const stockMessage = document.getElementById('stockMessage');
            // Initialiser maxStock depuis le JSON côté serveur — zéro délai
            let maxStock = (() => {
                try {
                    const data = JSON.parse(document.getElementById('productVariantsData').textContent);
                    if (!data || !data[0]) return 0;
                    const v = data[0];
                    if (!v.sizes || v.sizes.length === 0) return 0;
                    // Stock de la première taille avec stock > 0
                    const s = v.sizes.find(s => s.stock > 0);
                    return s ? parseInt(s.stock, 10) : 0;
                } catch(e) { return 0; }
            })();

            async function fetchStock(size, variantId) {
                try {
                    const response = await fetch(`/api/get-stock?size=${size}&variantId=${variantId}`);
                    const data = await response.json();
                    return data.stock !== undefined ? parseInt(data.stock, 10) : 0;
                } catch (error) {
                    console.error('Erreur réseau lors de la récupération du stock:', error);
                    return 0;
                }
            }

            // CORRECTION 2 : lecture instantanée de data-stock au chargement (pas de fetch)
            function applyStockUI(stock, variantId) {
                maxStock = stock;
                resetQuantity();
                updateIncrementButton();
                // Mettre à jour le data-variant-id sur le bouton "Ajouter au panier"
                const addToCartBtn = addToCartContainer.querySelector('.btn-addtocart');
                if (addToCartBtn && variantId) addToCartBtn.dataset.variantId = variantId;
                if (stock > 0) {
                    quantityInput.style.display = 'block';
                    incrementButton.style.display = 'block';
                    addToCartContainer.style.display = 'block';
                    decreaseButton.style.display = 'block';
                    stockMessage.style.display = 'none';
                } else {
                    quantityInput.style.display = 'none';
                    incrementButton.style.display = 'none';
                    addToCartContainer.style.display = 'none';
                    decreaseButton.style.display = 'none';
                    stockMessage.style.display = 'block';
                }
            }

            function getStockFromJSON(variantId) {
                // Lit le stock directement depuis productVariantsData sans fetch réseau
                try {
                    const data = JSON.parse(document.getElementById('productVariantsData').textContent);
                    const v = data.find(vv => String(vv.id) === String(variantId)) || data[0];
                    if (!v) return 0;
                    // Somme du stock de toutes les tailles (ou première taille si une seule)
                    const sizes = v.sizes || [];
                    return sizes.reduce((acc, s) => acc + parseInt(s.stock || 0, 10), 0);
                } catch(e) { return 0; }
            }

            function initStockFromHTML() {
                const selectedOption = sizeSelect ? sizeSelect.options[sizeSelect.selectedIndex] : null;
                if (selectedOption) {
                    const variantId = selectedOption.getAttribute('data-variant-id') || '';
                    const sizeName  = (selectedOption.value || '').trim().toUpperCase();
                    if (sizeName.includes('INDISPONIBLE')) {
                        // Taille INDISPONIBLE → lire le stock total du variant depuis le JSON
                        const stock = getStockFromJSON(variantId);
                        applyStockUI(stock, variantId);
                    } else {
                        const stock = parseInt(selectedOption.getAttribute('data-stock') || '0', 10);
                        applyStockUI(stock, variantId);
                    }
                } else {
                    // Pas d'option du tout → fallback JSON premier variant
                    try {
                        const data = JSON.parse(document.getElementById('productVariantsData').textContent);
                        const v = data[0];
                        if (v) {
                            const stock = getStockFromJSON(v.id);
                            applyStockUI(stock, String(v.id));
                        }
                    } catch(e) { console.warn('initStockFromHTML fallback error', e); }
                }
            }

            async function updateStock() {
                const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
                const selectedSize   = selectedOption.value;
                const variantId      = selectedOption.getAttribute('data-variant-id');
                if (!selectedSize || !variantId) return;
                // Si taille INDISPONIBLE → pas de fetch, on lit le JSON directement
                if (selectedSize.trim().toUpperCase().includes('INDISPONIBLE')) {
                    const stock = getStockFromJSON(variantId);
                    applyStockUI(stock, variantId);
                    return;
                }
                const stock = await fetchStock(selectedSize, variantId);
                applyStockUI(stock, variantId);
            }

            function resetQuantity() {
                quantityInput.value = 1;
            }

            function updateIncrementButton() {
                const quantity = parseInt(quantityInput.value, 10) || 1;
                incrementButton.style.display = quantity >= maxStock ? 'none' : 'inline-block';
            }

            sizeSelect.addEventListener('change', updateStock);
            if (colorSelect) {
                colorSelect.addEventListener('change', () => {
                    resetQuantity();
                    updateIncrementButton();
                    updateStock();
                });
            }

            // Le thème gère déjà les clics + / - dans son propre JS.
            // On observe juste le changement de valeur de l'input pour mettre à jour le bouton +.
            const observer = new MutationObserver(() => updateIncrementButton());
            observer.observe(quantityInput, { attributes: true, attributeFilter: ['value'] });
            // Fallback : certains thèmes changent .value sans attribut → on écoute aussi les clics
            // mais UNIQUEMENT pour cacher/afficher le +, sans modifier la valeur.
            incrementButton.addEventListener('click', () => setTimeout(updateIncrementButton, 0));
            decreaseButton.addEventListener('click',  () => setTimeout(updateIncrementButton, 0));

            // État initial déjà rendu par Twig — initStockFromHTML() retiré pour éviter écrasement
        });


        document.addEventListener('DOMContentLoaded', function () {
            const colorSelect = document.getElementById('color');
            const sizeSelect = document.getElementById('size');
            const colorGroup = document.getElementById('color-group');
            const sizeGroup = document.getElementById('size-group');
            const priceDisplay = document.getElementById('variant-price');
            const oldPriceDisplay = document.getElementById('old-price');
            const discountDisplay = document.getElementById('variant-off');
            const variants = {{ variants|json_encode()|raw }};

            const isColorVisible = colorGroup && getComputedStyle(colorGroup).display !== 'none';
            const isSizeVisible = sizeGroup && getComputedStyle(sizeGroup).display !== 'none';

            function getActiveVariant() {
                let selectedColor = isColorVisible && colorSelect?.value ? colorSelect.value : null;
                let selectedSize = isSizeVisible && sizeSelect?.value ? sizeSelect.value : null;
                if (!selectedColor && variants.length > 0) { selectedColor = variants[0].color; }
                return variants.find(variant => {
                    const matchesColor = !selectedColor || variant.color === selectedColor;
                    const sizeArray = Array.isArray(variant.sizes) ? variant.sizes.map(s => typeof s === 'object' ? s.size : s) : [];
                    const matchesSize = !selectedSize || sizeArray.includes(selectedSize);
                    return matchesColor && matchesSize;
                });
            }

            function updatePrice() {
                const variant = getActiveVariant();
                if (variant) {
                    const finalPrice = variant.price - (variant.price * (variant.offVariant || 0) / 100);
                    priceDisplay.textContent = `${finalPrice.toFixed(2)} €`;
                    if (variant.offVariant > 0) {
                        oldPriceDisplay.textContent = `${variant.price.toFixed(2)} €`;
                        oldPriceDisplay.style.display = 'inline';
                        discountDisplay.textContent = `${variant.offVariant}% réduction`;
                        discountDisplay.style.display = 'block';
                    } else {
                        oldPriceDisplay.style.display = 'none';
                        discountDisplay.style.display = 'none';
                    }
                } else {
                    priceDisplay.textContent = 'Prix indisponible';
                    oldPriceDisplay.style.display = 'none';
                    discountDisplay.style.display = 'none';
                }
            }

            function updateImages() {
                const variant = getActiveVariant();
                const mainImage = document.getElementById('main_product_img');
                const thumbnailsContainer = document.getElementById('thumbnails');
                if (variant && variant.images?.length > 0) {
                    const firstImg = variant.images[0];
                    mainImage.src = `/images/products/${firstImg.imageName || firstImg}`;
                } else {
                    mainImage.src = '/images/products/default.jpg';
                    if (thumbnailsContainer) thumbnailsContainer.innerHTML = '';
                }
            }

            if (colorSelect) colorSelect.addEventListener('change', () => { updatePrice(); updateImages(); });
            if (sizeSelect) sizeSelect.addEventListener('change', () => { updatePrice(); updateImages(); });
            updatePrice();
            updateImages();
        });


        document.addEventListener('DOMContentLoaded', function () {
            const colorOptions = document.querySelectorAll('#color option');
            const sizeOptions  = document.querySelectorAll('#size option');
            if (colorOptions.length > 0 && Array.from(colorOptions).every(opt => opt.value.trim().toUpperCase().includes('INDISPONIBLE'))) {
                document.getElementById('color-group')?.style.setProperty('display', 'none', 'important');
            }
            if (sizeOptions.length > 0 && Array.from(sizeOptions).every(opt => opt.value.trim().toUpperCase().includes('INDISPONIBLE'))) {
                document.getElementById('size-group')?.style.setProperty('display', 'none', 'important');
            }
        });


        document.addEventListener('DOMContentLoaded', function () {
            const colorSelect = document.getElementById('color');
            const sizeSelect = document.getElementById('size');
            const colorGroup = document.getElementById('color-group');
            const sizeGroup = document.getElementById('size-group');
            const mainImage = document.getElementById('main_product_img');
            const thumbnailsContainer = document.getElementById('thumbnails');
            const priceDisplay = document.getElementById('variant-price');
            const oldPriceDisplay = document.getElementById('old-price');
            const discountDisplay = document.getElementById('variant-off');
            const variants = {{ variants|json_encode()|raw }};

            function isVisible(el) { return el && window.getComputedStyle(el).display !== 'none'; }

            function getActiveVariant() {
                const colorVisible = isVisible(colorGroup);
                const sizeVisible = isVisible(sizeGroup);
                let selectedColor = colorVisible && colorSelect?.value ? colorSelect.value : null;
                let selectedSize = sizeVisible && sizeSelect?.value ? sizeSelect.value : null;
                if (!selectedColor && variants.length > 0) { return variants[0]; }
                return variants.find(v => {
                    const matchesColor = !selectedColor || v.color === selectedColor;
                    const sizeArray = Array.isArray(v.sizes) ? v.sizes.map(s => typeof s === 'object' ? s.size : s) : [];
                    const matchesSize = !selectedSize || sizeArray.includes(selectedSize);
                    return matchesColor && matchesSize;
                });
            }

            function updatePrice() {
                const variant = getActiveVariant();
                if (variant) {
                    const finalPrice = variant.price - (variant.price * (variant.offVariant || 0) / 100);
                    priceDisplay.textContent = `${finalPrice.toFixed(2)} €`;
                    if (variant.offVariant > 0) {
                        oldPriceDisplay.textContent = `${variant.price.toFixed(2)} €`;
                        oldPriceDisplay.style.display = 'inline';
                        discountDisplay.textContent = `${variant.offVariant}% réduction`;
                        discountDisplay.style.display = 'block';
                    } else {
                        oldPriceDisplay.style.display = 'none';
                        discountDisplay.style.display = 'none';
                    }
                } else {
                    priceDisplay.textContent = 'Prix indisponible';
                    oldPriceDisplay.style.display = 'none';
                    discountDisplay.style.display = 'none';
                }
            }

            function updateImages() {
                const variant = getActiveVariant();
                if (!variant || !variant.images || variant.images.length === 0) {
                    mainImage.src = '/images/products/default.jpg';
                    if (thumbnailsContainer) thumbnailsContainer.innerHTML = '';
                    return;
                }
                const firstImage = variant.images[0];
                const imageName = firstImage.imageName || firstImage;
                mainImage.src = `/images/products/${imageName}`;
                thumbnailsContainer.innerHTML = '';
                const images = variant.images.filter(img => !/\.(mp4|webm)$/.test((img.imageName || img).toLowerCase()));
                const videos = variant.images.filter(img => /\.(mp4|webm)$/.test((img.imageName || img).toLowerCase()));

                images.slice(0, 5).forEach((img, index) => {
                    const name = img.imageName || img;
                    const thumbnail = document.createElement('div');
                    thumbnail.classList.add('mb-3', 'mx-2');
                    if (index === 4 && images.length > 5) {
                        const remaining = images.length - 5;
                        thumbnail.innerHTML = `<div class="thumbnail_img_box" style="width:60px;height:60px;position:relative;"><a href="/images/products/${name}" data-fancybox="product-images" data-fancybox-index="${index}" data-large-src="/images/products/${name}"><img src="/images/products/${name}" class="thumbnail img-fluid" style="width:100%;height:100%;object-fit:cover;opacity:0.6;"><div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:white;font-weight:bold;font-size:16px;text-shadow:0 0 5px rgba(0,0,0,0.5);z-index:10;">+${remaining}</div></a></div>`;
                    } else {
                        thumbnail.innerHTML = `<div class="thumbnail_img_box" style="width:60px;height:60px;position:relative;"><a href="/images/products/${name}" data-fancybox="product-images" data-fancybox-index="${index}" data-large-src="/images/products/${name}"><img src="/images/products/${name}" class="thumbnail img-fluid" style="width:100%;height:100%;object-fit:cover;"></a></div>`;
                    }
                    thumbnailsContainer.appendChild(thumbnail);
                });

                if (images.length > 5) {
                    const fancyboxContainer = document.createElement('div');
                    fancyboxContainer.style.display = 'none';
                    fancyboxContainer.classList.add('fancybox-container');
                    images.slice(5).forEach((img, i) => {
                        const name = img.imageName || img;
                        const link = document.createElement('a');
                        link.href = `/images/products/${name}`;
                        link.setAttribute('data-fancybox', 'product-images');
                        link.setAttribute('data-fancybox-index', (i + 5).toString());
                        const imgEl = document.createElement('img');
                        imgEl.src = `/images/products/${name}`;
                        link.appendChild(imgEl);
                        fancyboxContainer.appendChild(link);
                    });
                    thumbnailsContainer.appendChild(fancyboxContainer);
                }

                if (videos.length > 0) {
                    const video = videos[0];
                    const videoName = video.imageName || video;
                    const thumbName = video.thumbnailName || videoName.replace(/\.(mp4|webm)$/i, '.jpg');
                    const thumbnail = document.createElement('div');
                    thumbnail.classList.add('mb-3', 'mx-2');
                    thumbnail.innerHTML = `<div class="thumbnail_img_box" style="width:60px;height:60px;position:relative;background:#000;"><a href="/images/products/${videoName}" data-fancybox="product-images" data-fancybox-index="${images.length}" data-type="video" data-large-src="/images/products/${thumbName}"><div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:10;"><svg width="30" height="30" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg></div></a></div>`;
                    thumbnailsContainer.appendChild(thumbnail);
                }

                if (typeof Fancybox !== 'undefined') {
                    Fancybox.bind('[data-fancybox="product-images"]', { groupAll: true });
                }
            }

            if (colorSelect) colorSelect.addEventListener('change', () => { updatePrice(); updateImages(); });
            if (sizeSelect) sizeSelect.addEventListener('change', () => { updatePrice(); updateImages(); });
            updatePrice();
            updateImages();
        });


        {# === DEBUG PANIER + PRIX AU CHARGEMENT === #}
        document.addEventListener('DOMContentLoaded', function () {
            const variantsData = JSON.parse(document.getElementById('productVariantsData').textContent);
            const addToCartBtn = document.querySelector('.btn-addtocart');
            const priceDisplay  = document.getElementById('variant-price');
            const oldPriceDisplay = document.getElementById('old-price');
            const discountDisplay = document.getElementById('variant-off');

            // ── PRIX AU CHARGEMENT : lecture immédiate depuis JSON (pas d'attente JS) ──
            if (variantsData.length > 0) {
                const v = variantsData[0];
                const finalPrice = v.price - (v.price * (v.offVariant || 0) / 100);
                if (priceDisplay) priceDisplay.textContent = finalPrice.toFixed(2) + ' €';
                if (v.offVariant > 0) {
                    if (oldPriceDisplay) { oldPriceDisplay.textContent = v.price.toFixed(2) + ' €'; oldPriceDisplay.style.display = 'inline'; }
                    if (discountDisplay) { discountDisplay.querySelector('span').textContent = v.offVariant + '% réduction'; discountDisplay.style.display = 'block'; }
                }
            }

            // ── DEBUG PANIER ──
            if (!addToCartBtn) {
                console.error('[PANIER] .btn-addtocart introuvable dans le DOM');
                return;
            }

            addToCartBtn.addEventListener('click', function (e) {
                const vid = this.dataset.variantId;
                console.log('[PANIER] Clic sur Ajouter au panier');
                console.log('[PANIER] data-variant-id =', vid);
                if (!vid) {
                    console.error('[PANIER] ❌ data-variant-id est VIDE — le thème ne peut pas envoyer la requête');
                } else {
                    console.log('[PANIER] ✅ variant ID ok →', vid);
                }
            });

            // Vérifie aussi que l'ID est bien mis à jour à chaque changement
            const observer = new MutationObserver(() => {
                console.log('[PANIER] data-variant-id mis à jour →', addToCartBtn.dataset.variantId);
            });
            observer.observe(addToCartBtn, { attributes: true, attributeFilter: ['data-variant-id'] });
        });
        document.addEventListener('DOMContentLoaded', function () {
            const colorSelect  = document.getElementById('color');
            const sizeSelect   = document.getElementById('size');
            const eanBlock     = document.getElementById('ean-block');
            const eanValue     = document.getElementById('ean-value');
            const variantsData = JSON.parse(document.getElementById('productVariantsData').textContent);

            function updateEan() {
                const color = colorSelect ? colorSelect.value : null;
                const v = color
                    ? variantsData.find(vv => vv.color === color)
                    : variantsData[0];
                if (!eanBlock || !eanValue) return;
                if (v && v.ean) {
                    eanValue.textContent   = v.ean;
                    eanBlock.style.display = 'flex';
                } else {
                    eanBlock.style.display = 'none';
                }
            }

            if (colorSelect) colorSelect.addEventListener('change', updateEan);
            if (sizeSelect)  sizeSelect.addEventListener('change',  updateEan);
            updateEan();
        });

    </script>


