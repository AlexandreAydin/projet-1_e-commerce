{% extends 'base.html.twig' %}

{% block title %}Yilmi poruduit{% endblock %}
{% block stylesheets %}
    {# {{ parent() }} <!-- Ensures that the parent styles are included --> #}
    <link rel="stylesheet" href="{{ asset('assets/css/single_product.css') }}">
{% endblock %}
 
{% block body %}
    <link rel="stylesheet" href="asset {{"assets/css/single_product.css"}}">
    <div class="section">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-6 mb-4 mb-md-0">
                    <div class="product-image product-image-sticky">
                        <div class="main_image_container position-relative">
                            <div class="mb-4">
                                {# Image initiale rendue côté serveur — zéro délai #}
                                {% set first_img = null %}
                                {% for v in product.variants %}
                                    {% if first_img is null and v.variantImages|length > 0 %}
                                        {% set first_img = v.variantImages|first %}
                                    {% endif %}
                                {% endfor %}
                                <img id="main_product_img"
                                     src="{{ first_img ? asset('images/products/' ~ first_img.imageName) : asset('images/products/default.jpg') }}"
                                     alt="Image principale"
                                     style="height: 100%; width: 100%; object-fit: cover;" />
                            </div>
                        </div>

                        <div id="thumbnails" class="row">
                            {# Miniatures initiales rendues côté serveur #}
                            {% if first_img is not null %}
                                {% set first_variant = null %}
                                {% for v in product.variants %}
                                    {% if first_variant is null and v.variantImages|length > 0 %}
                                        {% set first_variant = v %}
                                    {% endif %}
                                {% endfor %}
                                {% if first_variant %}
                                    {% set imgs = first_variant.variantImages|filter(i => not (i.imageName matches '/\.(mp4|webm)$/i')) %}
                                    {% for image in imgs|slice(0, 5) %}
                                        <div class="mb-3 mx-2">
                                            <div class="thumbnail_img_box" style="width:60px;height:60px;position:relative;">
                                                <a href="/images/products/{{ image.imageName }}"
                                                   data-fancybox="product-images"
                                                   data-large-src="/images/products/{{ image.imageName }}">
                                                    <img src="/images/products/{{ image.imageName }}"
                                                         class="thumbnail img-fluid"
                                                         style="width:100%;height:100%;object-fit:cover;">
                                                </a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <div class="pr_detail">
                        <div class="product_description">
                            <h4 class="product_title">{{ product.name }}</h4>
                            {% set first_variant = product.variants|first %}
                            {% if first_variant %}
                                {% set init_price = first_variant.price %}
                                {% set init_off   = first_variant.offVariant ?? 0 %}
                                {% set init_final = init_price - (init_price * init_off / 100) %}
                            {% endif %}
                            <div class="product_price d-flex variant-price" style=" margin-left: 0;">
                                <span id="variant-price" class="price">{{ first_variant ? init_final|number_format(2, '.', '') ~ ' €' : '-- €' }}</span>
                                <del id="old-price" style="display: {{ (first_variant and init_off > 0) ? 'inline' : 'none' }};">{{ first_variant ? init_price|number_format(2, '.', '') ~ ' €' : '-- €' }}</del>
                                <div id="variant-off" class="on_sale" style="display: {{ (first_variant and init_off > 0) ? 'block' : 'none' }};">
                                <span>{{ (first_variant and init_off > 0) ? init_off ~ '% réduction' : '--% réduction' }}</span>
                            </div>
                        </div> 
                        <hr class="hr-price">
                            <a href="javascript:void(0);" class="rating_wrap">
                                <div class="rating">
                                    <div class="product_rate" style="width: {{ (averageRating * 20) | round(0, 'floor') }}%"></div>
                                </div>
                                <span class="rating_num">({{ product.rewiewsProducts | length }})</span>
                            </a>
                            <br>
                            <br>
                            <hr>

                            {# ── SEUL CHANGEMENT : badges modernes + EAN dynamique ── #}
                            <div class="product_sort_info">
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    {% if product.isWarranty %}
                                    <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;background:#f0faf4;border:1px solid #b7dfc8;color:#2d7a4f;font-size:13px;font-weight:600;">
                                        <i class="linearicons-shield-check"></i> Garantie
                                    </span>
                                    {% endif %}
                                    <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;background:#f0f6ff;border:1px solid #b3cdf0;color:#2a5cb8;font-size:13px;font-weight:600;">
                                        <i class="linearicons-truck"></i> Livraison Rapide
                                    </span>
                                    <span style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;background:#fffbf0;border:1px solid #f0dcb3;color:#a0700a;font-size:13px;font-weight:600;">
                                        <i class="linearicons-bag-dollar"></i> Paiement sécurisé
                                    </span>
                                </div>
                                {# EAN initial : première variante avec un EAN #}
                                {% set init_ean = '' %}
                                {% for v in product.variants %}
                                    {% if init_ean == '' and v.ean %}
                                        {% set init_ean = v.ean %}
                                    {% endif %}
                                {% endfor %}
                                <div id="ean-block" style="display:{{ init_ean ? 'flex' : 'none' }};align-items:center;gap:8px;padding:8px 14px;border-radius:10px;background:#fafafa;border:1px solid #e8e8e8;width:fit-content;">
                                    <i class="linearicons-barcode" style="color:#555;font-size:16px;"></i>
                                    <div style="line-height:1.3;">
                                        <span style="font-size:10px;color:#999;text-transform:uppercase;letter-spacing:.5px;display:block;">EAN / Code-barres</span>
                                        <span id="ean-value" style="font-size:14px;font-weight:700;color:#333;letter-spacing:1px;font-family:monospace;">{{ init_ean }}</span>
                                    </div>
                                </div>
                            </div>
                            {# ── FIN CHANGEMENT ── #}

                            {% set displayed_sizes = [] %}
                            {% set displayed_colors = [] %}
                        
                            <!-- Sélection de la couleur -->
                            {# <div class="d-flex variant-product">
                                <!-- Sélection de la couleur -->
                                <div class="form-group">
                                    <label for="color">Couleur :</label>
                                    <select name="color" id="color" class="form-control">
                                        {% set displayed_colors = [] %}
                                        {% for variant in product.variants %}
                                            {% if variant.color not in displayed_colors %}
                                                <option value="{{ variant.color }}">{{ variant.color }}</option>
                                                {% set displayed_colors = displayed_colors|merge([variant.color]) %}
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="form-group mx-4">
                                    <label for="size">Taille :</label>
                                    <select name="size" id="size" class="form-control">
                                        {% for variant in product.variants %}
                                            {% for size in variant.sizes %}
                                                <option value="{{ size.size }}" data-variant-id="{{ variant.id }}" data-stock="{{ size.stock }}" data-color="{{ variant.color }}">
                                                    {{ size.size }}
                                                </option>
                                            {% endfor %}
                                        {% endfor %}
                                    </select>
                                </div>
                            </div> #}

                            {# === COULEUR === #}
                        <!-- Sélection de la couleur -->
                        <div class="d-flex flex-column variant-product">

                            {# === BLOC COULEUR === #}
                            {% set has_real_color = false %}
                            {% for variant in product.variants %}
                                {% if 'INDISPONIBLE' not in variant.color|trim|upper %}
                                    {% set has_real_color = true %}
                                {% endif %}
                            {% endfor %}

                            <div class="form-group" id="color-group" {% if not has_real_color %}style="display: none;"{% endif %}>
                                <label class="d-block mb-2">
                                    Couleur : <strong id="selected-color-name">
                                        {% set first_color_shown = false %}
                                        {% for variant in product.variants %}
                                            {% if not first_color_shown and 'INDISPONIBLE' not in variant.color|trim|upper %}
                                                {{ variant.color }}
                                                {% set first_color_shown = true %}
                                            {% endif %}
                                        {% endfor %}
                                    </strong>
                                </label>

                                {# Select caché — toutes les couleurs incluses (même INDISPONIBLE) pour que le thème puisse lire la valeur #}
                                <select name="color" id="color" class="form-control" style="display:none;">
                                    {% set displayed_colors = [] %}
                                    {% for variant in product.variants %}
                                        {% if variant.color not in displayed_colors %}
                                            <option value="{{ variant.color }}">{{ variant.color }}</option>
                                            {% set displayed_colors = displayed_colors|merge([variant.color]) %}
                                        {% endif %}
                                    {% endfor %}
                                </select>

                                {# Swatches modernes #}
                                <div class="color-swatches d-flex flex-wrap gap-2">
                                    {% set displayed_colors = [] %}
                                    {% set is_first = true %}
                                    {% for variant in product.variants %}
                                        {% if variant.color not in displayed_colors and 'INDISPONIBLE' not in variant.color|trim|upper %}
                                            <div class="color-swatch-item text-center" style="cursor:pointer; width:52px;">
                                                <div class="color-swatch-circle {% if is_first %}active{% endif %}"
                                                     data-color="{{ variant.color }}"
                                                     style="
                                                        width: 40px;
                                                        height: 40px;
                                                        border-radius: 50%;
                                                        background-color: {{ variant.colorHex ?? variant.color }};
                                                        margin: 0 auto 4px;
                                                        border: 2px solid {% if is_first %}#C8A96E{% else %}#ddd{% endif %};
                                                        box-shadow: {% if is_first %}0 0 0 2px #fff, 0 0 0 4px #C8A96E{% else %}none{% endif %};
                                                        transition: all .2s;
                                                     ">
                                                </div>
                                                <span style="font-size:10px; color:#555; display:block; line-height:1.2; word-break:break-word;">
                                                    {{ variant.color }}
                                                </span>
                                            </div>
                                            {% set displayed_colors = displayed_colors|merge([variant.color]) %}
                                            {% set is_first = false %}
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>

                            {# === BLOC TAILLE === #}
                            {% set has_real_size = false %}
                            {% for variant in product.variants %}
                                {% for size in variant.sizes %}
                                    {% if 'INDISPONIBLE' not in size.size|trim|upper %}
                                        {% set has_real_size = true %}
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}

                            <div class="form-group mt-3" id="size-group" {% if not has_real_size %}style="display: none;"{% endif %}>
                                <label class="d-block mb-2">
                                    Taille : <strong id="selected-size-name">
                                        {% set first_size_shown = false %}
                                        {% for variant in product.variants %}
                                            {% for size in variant.sizes %}
                                                {% if not first_size_shown and 'INDISPONIBLE' not in size.size|trim|upper %}
                                                    {{ size.size }}
                                                    {% set first_size_shown = true %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    </strong>
                                </label>

                                {# Select caché — toutes les tailles incluses (même INDISPONIBLE) pour que le stock soit lisible #}
                                <select name="size" id="size" class="form-control" style="display:none;">
                                    {% for variant in product.variants %}
                                        {% for size in variant.sizes %}
                                            <option value="{{ size.size }}"
                                                    data-variant-id="{{ variant.id }}"
                                                    data-stock="{{ size.stock }}"
                                                    data-color="{{ variant.color }}">
                                                {{ size.size }}
                                            </option>
                                        {% endfor %}
                                    {% endfor %}
                                </select>

                                {# Pills modernes — seules les tailles de la première couleur active sont visibles au chargement #}
                                {% set init_color = '' %}
                                {% for v in product.variants %}
                                    {% if init_color == '' and 'INDISPONIBLE' not in v.color|trim|upper %}
                                        {% set init_color = v.color %}
                                    {% endif %}
                                {% endfor %}
                                {# Si toutes les couleurs sont INDISPONIBLE, prendre la première quand même #}
                                {% if init_color == '' and product.variants|length > 0 %}
                                    {% set init_color = product.variants|first.color %}
                                {% endif %}
                                <div class="size-pills d-flex flex-wrap gap-2" id="size-pills-container">
                                    {% set displayed_sizes = [] %}
                                    {% set is_first_size = true %}
                                    {% for variant in product.variants %}
                                        {% for size in variant.sizes %}
                                            {% if 'INDISPONIBLE' not in size.size|trim|upper and size.size not in displayed_sizes %}
                                                {# Visible uniquement si cette pill correspond à la couleur initiale #}
                                                {% set pill_visible = (variant.color == init_color) %}
                                                {% set pill_active  = (is_first_size and pill_visible) %}
                                                <button type="button"
                                                        class="size-pill {% if pill_active %}active{% endif %}"
                                                        data-size="{{ size.size }}"
                                                        data-color="{{ variant.color }}"
                                                        {% if size.stock == 0 %}data-out-of-stock="1"{% endif %}
                                                        style="
                                                            display: {% if pill_visible %}inline-flex{% else %}none{% endif %};
                                                            align-items: center;
                                                            justify-content: center;
                                                            min-width: 44px;
                                                            height: 36px;
                                                            padding: 0 12px;
                                                            border-radius: 6px;
                                                            border: 2px solid {% if pill_active %}#C8A96E{% else %}#ddd{% endif %};
                                                            background: {% if pill_active %}#C8A96E{% else %}#fff{% endif %};
                                                            color: {% if pill_active %}#fff{% else %}#333{% endif %};
                                                            font-size: 13px;
                                                            font-weight: 600;
                                                            cursor: {% if size.stock == 0 %}not-allowed{% else %}pointer{% endif %};
                                                            opacity: {% if size.stock == 0 %}0.4{% else %}1{% endif %};
                                                            transition: all .2s;
                                                            position: relative;
                                                        ">
                                                    {{ size.size }}
                                                    {% if size.stock == 0 %}
                                                        <span style="position:absolute;top:50%;left:0;width:100%;height:1px;background:#999;transform:rotate(-15deg);"></span>
                                                    {% endif %}
                                                </button>
                                                {% if pill_visible %}
                                                    {% set displayed_sizes = displayed_sizes|merge([size.size]) %}
                                                    {% set is_first_size = false %}
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                </div>
                            </div>

                        </div>
                        {# Stock initial calculé côté serveur — zéro flash #}
                        {% set init_stock = 0 %}
                        {% set init_variant_id = '' %}
                        {% for v in product.variants %}
                            {% for s in v.sizes %}
                                {% if init_stock == 0 and s.stock > 0 %}
                                    {% set init_stock = s.stock %}
                                    {% set init_variant_id = v.id %}
                                {% endif %}
                            {% endfor %}
                            {# Si pas de tailles du tout, prendre le premier variant_id uniquement #}
                            {% if init_variant_id == '' %}
                                {% set init_variant_id = v.id %}
                            {% endif %}
                        {% endfor %}
                        <div class="cart_extra col-12">
                            <div id="stockMessage" class="stock-message" style="display: {{ init_stock > 0 ? 'none' : 'block' }};">
                                Ce produit est indisponible pour le moment.
                            </div>

                            <!-- Quantité et boutons -->
                            <div class="cart-product-quantity mb-4">
                                <div class="quantity" style="display: {{ init_stock > 0 ? 'flex' : 'none' }};">
                                    <input type="button" value="-" class="minus">
                                    <input type="" id="quantity" name="quantity" value="1" title="Qty" size="4" min="1" class="qty" readonly>
                                    <input type="button" value="+" class="plus">
                                </div>
                            </div>

                            <div class="cart_btn mb-4" style="display: {{ init_stock > 0 ? 'block' : 'none' }};">
                                <a href="#"
                                    class="btn btn-fill-out btn-addtocart"
                                    data-variant-id="{{ init_variant_id }}"
                                    type="button">
                                    <i class="icon-basket-loaded"></i> Ajouter au panier
                                </a>
                                <a class="add_compare" href="#"><i class="icon-shuffle"></i></a>
                            </div>
                        </div>
                            <hr>
                            <div>
                                <ul class="product-meta col-12 text-dark">
                                    {% if product.categorie %}
                                        <li class="text-dark"><strong>Catégorie: </strong>
                                            <a href="{{ path('app_categorie', {'slug': product.categorie.slug}) }}">
                                                {{ product.categorie.name }}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if product.subCategorie and product.categorie %}
                                        <li class="text-dark"><strong>Sous Catégorie: </strong>
                                            <a href="{{ path('app_sub_categorie', {'categorySlug': product.categorie.slug, 'subCategorySlug': product.subCategorie.slug}) }}">
                                                {{ product.subCategorie.name }}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if product.productBrand %}
                                        <li class="text-dark"><strong>Marque: </strong>
                                            <a href="{{ path('app_marque', {'slug': product.productBrand.slug}) }}">
                                                {{ product.productBrand.name }}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if product.brandModel and product.productBrand %}
                                        <li class="text-dark"><strong>Modèle: </strong>
                                            <a href="{{ path('app_brand_model', {'brandSlug': product.productBrand.slug, 'modelSlug': product.brandModel.slug}) }}">
                                                {{ product.brandModel.name }}
                                            </a>
                                        </li>
                                    {% endif %}
                                    {% if product.moreInformations and product.moreInformations %}
                                    <li class="toggle-more-li">
                                        <span class="toggle-more text-dark" style="cursor: pointer; text-decoration: underline;">
                                            <i class="fas fa-chevron-down"></i> Voir plus
                                        </span>
                                    </li>
                                    <div class="more-info-content" style="display: none;">
                                        {{ product.moreInformations | raw }}
                                        <li class="toggle-less-li">
                                            <span class="toggle-less text-dark" style="cursor: pointer; text-decoration: underline;">
                                                <i class="fas fa-chevron-up"></i> Voir moins
                                            </span>
                                        </li>
                                    </div>
                                    {% endif %}
                                </ul>
                            </div>
                            </div> 
                            <hr>
                            <div class='mt-4 text-dark mx-2'>
                                <h2>À propos de cet article</h2>
                                <p class='mt-4 text-dark mx-2'>{{ product.description | raw }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br><br>
            {% if product.illustrationText1 %}

                <div class=" nav nav-tabs">
                    <div class="mx-4 mt-4">
                        {{ product.illustrationText1 | raw }}
                    </div>
                </div>
            {% endif %}
            <div class="">
                <div class="col-12">
                    <div class="container tab-style3" id="Reviews" role="" aria-labelledby="">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <p class="text-dark text-uppercase">Description</p>
                            </li>
                        </ul>
                        <div class="tab-content shop_info_tab">
                            <div class="container" id="Description">
                                <p>{{ product.description2  | raw }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container tab-style3" id="Reviews" role="" aria-labelledby="">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <p class="text-dark text-uppercase">Commentaire ({{ reviewCount }})</p>
                    </li>
                </ul>
                <div class="comments">
                    <div id="cm_cr_dp_d_rating_histogram" class="a-section celwidget reviews-clients">
                        <div class="a-row">
                            <h3>Commentaires client</h3>
                        </div>
                        <div class="rating_wrap mb-2">
                            <div class="rating">
                                <div class="product_rate" style="width: {{ (averageRating * 20) | round(0, 'floor') }}%"></div>
                            </div>
                                    <span class="average_rating">{{ averageRating | round(1, 'floor') }} sur 5</span>
                        </div>
                        
                        <!-- Display Histogram of Ratings -->
                        {% for review in reviews %}
                        {% set note = review.note %}
                            {# {% if note >= 1 and note <= 5 %}
                            
                            {% endif %} #}
                        {% endfor %}
                        <div class="a-fixed-left-grid a-spacing-none">
                            <div class="a-fixed-left-grid-inner">
                                <div class="a-fixed-left-grid-col a-col-left">
                                    <table id="histogramTable" class="a-normal a-align-center a-spacing-base">
                                        <tbody>
                                        <div class="a-row a-spacing-medium averageStarRatingNumerical mb-2">
                                            <span class="a-size-base a-color-secondary">{{ totalReviews }}&nbsp;évaluations globales et {{ reviewCount }} avis</span>
                                        </div>
                                        {% for star in [5, 4, 3, 2, 1] %}
                                        {% set percentage = totalReviews > 0 ? (starCounts[star]/totalReviews)*100 : 0 %}
                                        <tr class="a-histogram-row a-align-center">
                                            <td class="aok-nowrap a-nowrap">
                                                <a class="a-size-base a-link-normal">{{ star }} étoiles</a>
                                            </td>
                                            <td class="a-span10">
                                                <div class="a-meter" role="progressbar" aria-valuenow="{{ percentage }}">
                                                    <div class="a-meter-bar" style="width:{{ percentage }}%"></div>
                                                </div>
                                            </td>
                                            <td class="a-text-right a-nowrap a-nowrap">
                                                <a class="a-size-base a-link-normal">{{ percentage | round(0, 'floor') }}%</a>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h5 class="product_tab_title">({{ reviewCount }}) Commentaire <span>{{product.name}}</span></h5>
                    <ul class="container list_none comment_list mt-4">
                        {% for review in reviews %}
                            {% if review.comment %}
                                <li>
                                    <div class="comment_img">
                                        <img  src="{{ asset('assets/images/fa-user.png') }}"  alt="user2"/>
                                    </div>
                                    <div class="comment_block">
                                        <div class="customer_meta">
                                            <div>
                                                <span class="review_author">{{ review.user.firstname }}</span>
                                            </div>
                                             <div class="rating_wrap">
                                                <div class="rating">
                                                    <div class="product_rate" style="width: {{ review.note * 20 }}%"></div>
                                                </div>
                                            </div>
                                            <div>
                                                <span class="comment-date">{{ review.createdAt|date("d M, Y", "Europe/Paris", "fr_FR") }}</span>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="description">
                                            <p>{{ review.comment }}</p>
                                        </div>
                                        <hr>
                                        <div class="review_images mt-4">
                                            {% if review.rewiewImage %}
                                                <a href="{{ asset('uploads/images/' ~ review.rewiewImage) }}" data-fancybox="review-gallery-{{ review.id }}" data-caption="Image 1">
                                                    <img src="{{ asset('uploads/images/' ~ review.rewiewImage) }}" alt="Image 1" class="img-fluid" width="200" height="150">
                                                </a>
                                            {% endif %}
                                            {% if review.rewiewImages2 %}
                                                <a href="{{ asset('uploads/images/' ~ review.rewiewImages2) }}" data-fancybox="review-gallery-{{ review.id }}" data-caption="Image 2">
                                                    <img src="{{ asset('uploads/images/' ~ review.rewiewImages2) }}" alt="Image 2" class="img-fluid" width="200" height="150">
                                                </a>
                                            {% endif %}
                                            {% if review.rewiewImages3 %}
                                                <a href="{{ asset('uploads/images/' ~ review.rewiewImages3) }}" data-fancybox="review-gallery-{{ review.id }}" data-caption="Image 3">
                                                    <img src="{{ asset('uploads/images/' ~ review.rewiewImages3) }}" alt="Image 3" class="img-fluid" width="200" height="150">
                                                </a>
                                            {% endif %}
                                            {% if review.rewiewImages4 %}
                                                <a href="{{ asset('uploads/images/' ~ review.rewiewImages4) }}" data-fancybox="review-gallery-{{ review.id }}" data-caption="Image 4">
