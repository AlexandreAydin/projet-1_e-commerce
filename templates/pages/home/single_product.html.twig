        document.addEventListener('DOMContentLoaded', function () {
            const sizeSelect = document.getElementById('size');
            const colorSelect = document.getElementById('color');
            const quantityInput = document.getElementById('quantity');
            const incrementButton = document.querySelector('.plus');
            const decreaseButton = document.querySelector('.minus');
            const addToCartContainer = document.querySelector('.cart_btn');
            const stockMessage = document.getElementById('stockMessage');
            let maxStock = 0;

            async function fetchStock(size, variantId) {
                try {
                    const response = await fetch(`/api/get-stock?size=${size}&variantId=${variantId}`);
                    const data = await response.json();
                    return data.stock !== undefined ? parseInt(data.stock, 10) : 0;
                } catch (error) {
                    console.error('Erreur réseau lors de la récupération du stock:', error);
                    return 0;
                }
            }

            // CORRECTION 2 : lecture instantanée de data-stock au chargement (pas de fetch)
            function applyStockUI(stock, variantId) {
                maxStock = stock;
                resetQuantity();
                updateIncrementButton();
                if (stock > 0) {
                    quantityInput.style.display = 'block';
                    incrementButton.style.display = 'block';
                    addToCartContainer.style.display = 'block';
                    decreaseButton.style.display = 'block';
                    stockMessage.style.display = 'none';
                } else {
                    quantityInput.style.display = 'none';
                    incrementButton.style.display = 'none';
                    addToCartContainer.style.display = 'none';
                    decreaseButton.style.display = 'none';
                    stockMessage.style.display = 'block';
                }
            }

            function initStockFromHTML() {
                // Lit data-stock directement dans le HTML → instantané, zéro réseau
                const selectedOption = sizeSelect ? sizeSelect.options[sizeSelect.selectedIndex] : null;
                if (!selectedOption) return;
                const stock = parseInt(selectedOption.getAttribute('data-stock') || '0', 10);
                const variantId = selectedOption.getAttribute('data-variant-id') || '';
                applyStockUI(stock, variantId);
            }

            async function updateStock() {
                const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
                const selectedSize = selectedOption.value;
                const variantId = selectedOption.getAttribute('data-variant-id');
                if (!selectedSize || !variantId) {
                    console.warn('Taille ou variante non sélectionnée.');
                    return;
                }
                const stock = await fetchStock(selectedSize, variantId);
                applyStockUI(stock, variantId);
            }

            function resetQuantity() {
                quantityInput.value = 1;
            }

            function updateIncrementButton() {
                const quantity = parseInt(quantityInput.value, 10) || 1;
                incrementButton.style.display = quantity >= maxStock ? 'none' : 'inline-block';
            }

            sizeSelect.addEventListener('change', updateStock);
            if (colorSelect) {
                colorSelect.addEventListener('change', () => {
                    resetQuantity();
                    updateIncrementButton();
                    updateStock();
                });
            }

            // Le thème gère déjà les clics + / - dans son propre JS.
            // On observe juste le changement de valeur de l'input pour mettre à jour le bouton +.
            const observer = new MutationObserver(() => updateIncrementButton());
            observer.observe(quantityInput, { attributes: true, attributeFilter: ['value'] });
            // Fallback : certains thèmes changent .value sans attribut → on écoute aussi les clics
            // mais UNIQUEMENT pour cacher/afficher le +, sans modifier la valeur.
            incrementButton.addEventListener('click', () => setTimeout(updateIncrementButton, 0));
            decreaseButton.addEventListener('click',  () => setTimeout(updateIncrementButton, 0));

            // Au chargement : lecture instantanée HTML (pas de fetch → pas de délai)
            initStockFromHTML();
        });


