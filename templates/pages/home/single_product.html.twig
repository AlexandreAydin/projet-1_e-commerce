        document.addEventListener('DOMContentLoaded', function() {
            const colorSelect = document.getElementById('color');
            const mainImage = document.getElementById('main_product_img');
            const thumbnailsContainer = document.getElementById('thumbnails');
            const variants = {{ variants|json_encode()|raw }};
            
            function updateImages(selectedColor) {
                const selectedVariant = variants.find(variant => variant.color === selectedColor);
                if (selectedVariant && selectedVariant.images.length > 0) {
                    const firstImage = selectedVariant.images[0].imageName;
                    mainImage.src = `/images/products/${firstImage}`;
                    thumbnailsContainer.innerHTML = '';
                    const images = selectedVariant.images.filter(img => !/\.(mp4|webm)$/i.test(img.imageName));
                    const videos = selectedVariant.images.filter(img => /\.(mp4|webm)$/i.test(img.imageName));

                    images.slice(0, 5).forEach((image, index) => {
                        const thumbnail = document.createElement('div');
                        thumbnail.classList.add('mb-3', 'mx-2');
                        if (index === 4 && images.length > 5) {
                            const remainingImages = images.length - 5;
                            thumbnail.innerHTML = `<div class="thumbnail_img_box" style="width: 60px; height: 60px; position: relative;"><a href="/images/products/${image.imageName}" data-fancybox="product-images" data-fancybox-index="${index}" title="Miniature" data-large-src="/images/products/${image.imageName}"><img class="thumbnail img-fluid" src="/images/products/${image.imageName}" alt="Miniature" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.6;"><div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; font-weight: bold; font-size: 16px; text-shadow: 0 0 5px rgba(0,0,0,0.5); z-index: 10;">+${remainingImages}</div></a></div>`;
                        } else {
                            thumbnail.innerHTML = `<div class="thumbnail_img_box" style="width: 60px; height: 60px; position: relative;"><a href="/images/products/${image.imageName}" data-fancybox="product-images" data-fancybox-index="${index}" title="Miniature" data-large-src="/images/products/${image.imageName}"><img class="thumbnail img-fluid" src="/images/products/${image.imageName}" alt="Miniature" style="width: 100%; height: 100%; object-fit: cover;"></a></div>`;
                        }
                        thumbnailsContainer.appendChild(thumbnail);
                    });

                    if (images.length > 5) {
                        const existingFancyboxContainer = thumbnailsContainer.querySelector('.fancybox-container');
                        if (existingFancyboxContainer) { existingFancyboxContainer.remove(); }
                        const fancyboxContainer = document.createElement('div');
                        fancyboxContainer.classList.add('fancybox-container');
                        fancyboxContainer.style.display = 'none';
                        images.slice(5).forEach((image, index) => {
                            const link = document.createElement('a');
                            link.href = `/images/products/${image.imageName}`;
                            link.setAttribute('data-fancybox', 'product-images');
                            link.setAttribute('data-fancybox-index', (index + 5).toString());
                            link.setAttribute('title', 'Miniature');
                            const img = document.createElement('img');
