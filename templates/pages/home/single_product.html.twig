                } else {
                    mainImage.src = `/images/products/default.jpg`;
                    thumbnailsContainer.innerHTML = '';
                }
            }

            colorSelect.addEventListener('change', function() { updateImages(this.value); });
            if (colorSelect.value) { updateImages(colorSelect.value); }
        });


