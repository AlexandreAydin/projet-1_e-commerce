                let selectedSize = isSizeVisible && sizeSelect?.value ? sizeSelect.value : null;
                if (!selectedColor && variants.length > 0) { selectedColor = variants[0].color; }
                return variants.find(variant => {
                    const matchesColor = !selectedColor || variant.color === selectedColor;
                    const sizeArray = Array.isArray(variant.sizes) ? variant.sizes.map(s => typeof s === 'object' ? s.size : s) : [];
                    const matchesSize = !selectedSize || sizeArray.includes(selectedSize);
                    return matchesColor && matchesSize;
                });
            }

