{% extends 'base.html.twig' %}

{% block title %}Jstore | Product Wish list{% endblock %}

{% block body %}
<style>



.add-to-wishlist .fa-heart {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 10;
    color: white; /* Couleur de l'icône */
    font-size: 30px; /* Taille de l'icône */
    -webkit-text-stroke: 0.5px black; /* Contour noir de 2px */
    text-stroke: 0.5px black; /* Contour pour autres navigateurs */
    text-decoration: none; /* Supprime les soulignements */
}

.add-to-wishlist .fa-heart:hover {
    color: red; /* Change la couleur de l'icône au survol */
    -webkit-text-stroke: 0.5px black; /* Conserve le contour noir */
}

.add-to-wishlist.wishlist-active .fa-heart {
    color: red; /* Change la couleur pour les produits dans la wishlist */
    -webkit-text-stroke: 0.5px black; /* Conserve le contour noir */
}





</style>
<div  class="main_content wishlist_content" data-wishlist="{{wishlist_json}}">
    <div  class="section">
        <div  class="container">
            <div  class="row">
                <div  class="col-12">
                    <div  class="table-responsive wishlist_table">
                        <table  class="table">
                            <thead >
                                <tr >
                                    <th  class="product-thumbnail">&nbsp;</th>
                                    <th  class="product-name">Produit</th>
                                    <th  class="product-price"></th>
                                    <th  class="product-stock-status"></th>
                                    <th  class="product-add-to-cart"></th>
                                    <th  class="product-remove"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {# {% set subTotal = 0 %}
                                {% for product in wishList %} #}
                                    {# <tr>
                                    <td class="product-thumbnail">
                                            <a href="#">
                                                {% if product.product.getImages()|first %}
                                                    <img src="{{ asset('images/products/' ~ product.product.getImages()|first.getImageName()) }}" data-zoom-image="{{ asset('images/products/' ~ product.product.getImages()|first.getImageName()) }}" alt="{{ product.product.getName() }}">
                                                {% else %}
                                                    <img src="{{ asset('images/placeholder-image.jpg') }}" alt="Placeholder Image">
                                                {% endif %}
                                            </a>
                                        </td>
                                        <td class="product-name" data-title="Product"><a href="#">{{ product.product.name }}</a></td>
                                        <td class="product-price" data-title="Price">{{ ( product.product.price/100)  | number_format(2, '.', ' ') }}</td>
                                        {% if product.product.quantity > 10 %}
                                            <td data-title="Stock Status" class="product-stock-status">
                                                <span class="badge badge-pill badge-success">En Stock</span>
                                            </td>
                                        {% else %}
                                            <td class="product-price" data-title="Price">Il reste plus que {{  product.product.quantity }} articles dans le stock</td>
                                        {% endif %}
                                        <td class="product-add-to-cart">
                                            <a href="{{ path('app_add_to_cart', {'id':  product.product.id}) }}" class="btn btn-fill-out">
                                                <i class="icon-basket-loaded"></i> Add to Cart
                                            </a>
                                        </td>
                                        <td class="product-remove" data-title="Remove">
                                            <a href="{{ path('app_remove_to_wishList', {'id':  product.product.id}) }}"><i class="ti-close"></i></a>
                                        </td>
                                    </tr>
                                    
                                {% endfor %} #}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}