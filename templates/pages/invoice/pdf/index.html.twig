{% extends 'base.html.twig' %}

{% block title %}Invoice{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/invoice.css') }}">
{% endblock %}

{% block body %}

<style>
    body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        color: #333;
    }

    .container {
        width: 90%;
        margin: auto;
    }

    h1, h2, h3, strong {
        color: #222;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 10px;
        text-align: center;
        border: 1px solid #ddd;
    }

    thead {
        background-color: #f2f2f2;
    }

    tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    .customer-info {
        text-align: right;
    }

    .summary-table {
        width: 50%;
        margin-left: auto;
        text-align: right;
        border: 1px solid #ccc;
        margin-top: 40px;
    }

    .summary-table td {
        padding: 8px 12px;
        border: 1px solid #ccc;
    }

    .summary-table tr:last-child {
        background-color: #f1f1f1;
        font-weight: bold;
    }

    .info-section {
        display: flex;
        justify-content: space-between;
        margin-top: 40px;
    }

    .info-section div {
        width: 48%;
    }

    .company-details {
        font-weight: bold;
    }

    hr {
        border: 0;
        border-top: 1px solid #999;
        margin: 20px 0;
    }
</style>
<div class="container">
    <div class="header">
        <div class="company-info">
            Yilmi Market<br>
            38 RUE DE BERRI<br>
            75008 PARIS<br>
            France<br>
            Siret: 93947750100018<br>
            N° TVA Intracomm.: FR30 939 477 501
        </div>
        <div class="customer-info">
            {{ order.billingAddress | replace({'[spr]':'<br>'}) | raw }}
        </div>
    </div>

    <div class="order-info">
        <p><strong>Date de la commande:</strong> {{ order.createdAt | date('d-m-Y') }}</p>
        <p><strong>Référence de la commande:</strong> {{ order.reference }}</p>
        <p><strong>Numéro de Factures:</strong> {{ order.createdAt | date('m-Y') }}-{{ order.id }}</p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Référence</th>
                <th>Nom du Produit</th>
                <th>Quantité</th>
                <th>Sous Total HT</th>
                <th>Total TTC</th>
            </tr>
        </thead>
        <tbody>
            {% for detail in order.orderDetails %}
            <tr>
                <td>{{ detail.id }}</td>
                <td class='text-center'>
                {{ detail.productName|length > 50 
                    ? detail.productName|slice(0, 50) ~ '...' 
                    : detail.productName 
                }}
            </td>
                <td>{{ detail.quantity }}</td>
                <td>{{ (detail.variant.price / 1.2 * (1 - detail.variant.offVariant / 100) * detail.quantity) | round(2, 'common') | number_format(2, '.', ',') }} €</td>
                <td>{{ (detail.variant.price * (1 - detail.variant.offVariant / 100) * detail.quantity) | round(2, 'common') | number_format(2, '.', ',') }} €</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="summary-table">
        <tbody>
            {% if order.coupon %}
                <tr>
                    <td class="cart_total_label">Prix HT (avant la réduction):</td>
                    <td class="cart_total_amount">{{ (order.subTotalHT / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Taxe (avant la réduction):</td>
                    <td class="cart_total_amount">{{ (order.taxe / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Total TTC (avant la réduction):</td>
                    <td class="cart_total_amount">{{ (order.subTotalHT / 100 + order.taxe / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td colspan="2"><hr></td>
                </tr>
                <tr>
                    <td class="cart_total_label">Code promo appliqué:</td>
                    <td class="cart_total_amount">{{ order.coupon.code }}</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Réduction appliquée:</td>
                    <td class="cart_total_amount">{{ order.coupon.discountAmount | number_format(2, '.', ',') }}%</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Commande Sous total (après réduction):</td>
                    <td class="cart_total_amount">{{ ((order.subTotalHT * (1 - order.coupon.discountAmount / 100)) / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Taxe (après réduction):</td>
                    <td class="cart_total_amount">{{ ((order.taxe * (1 - order.coupon.discountAmount / 100)) / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Livraison avec ({{ order.carrierName }}):</td>
                    <td class="cart_total_amount">{{ order.carrierPrice / 100 | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr class="total-row">
                    <td class="cart_total_label"><strong>Total (après réduction):</strong></td>
                    <td class="cart_total_amount"><strong>{{ (((order.subTotalHT + order.taxe) * (1 - order.coupon.discountAmount / 100)) + order.carrierPrice) / 100 | number_format(2, '.', ',') }} €</strong></td>
                </tr>
            {% else %}
                <tr>
                    <td class="cart_total_label">Commande Sous total:</td>
                    <td class="cart_total_amount">{{ (order.subTotalHT / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Taxe:</td>
                    <td class="cart_total_amount">{{ (order.taxe / 100) | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr>
                    <td class="cart_total_label">Livraison avec ({{ order.carrierName }}):</td>
                    <td class="cart_total_amount">{{ order.carrierPrice / 100 | number_format(2, '.', ',') }} €</td>
                </tr>
                <tr class="total-row">
                    <td class="cart_total_label"><strong>Total:</strong></td>
                    <td class="cart_total_amount"><strong>{{ (order.subTotalHT / 100 + order.taxe / 100 + order.carrierPrice / 100) | number_format(2, '.', ',') }} €</strong></td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</div>
{% endblock %}