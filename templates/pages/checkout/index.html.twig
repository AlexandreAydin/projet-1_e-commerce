{% extends 'base.html.twig' %}

{% block title %}Yilmi Market Caisse{% endblock %}
{% block stylesheets %}
    {# {{ parent() }} <!-- Ensures that the parent styles are included --> #}
    <link rel="stylesheet" href="{{ asset('assets/css/checkout_index.css') }}">
{% endblock %}

{% block body %}

<div class="section checkout">
    <div class="container">
        {{ form_start(checkout, {action: path('app_checkout_confirm')}) }}
        <div class="row">
            <div class="col-md-6">
                <div class="heading_s1">
                    <h4>Votre Adresse de Livraison</h4>
                    <div class="content">
                           {{ form_widget(checkout.address, {'attr': { 'style': 'font-size: 1rem; height: 2.25rem;'}}) }}
                    </div>
                    <h4 class ="mt-4">Votre Adresse de Facturation</h4>
                     <div class="content">
                           {{ form_widget(checkout.billingAddress, {'attr': { 'style': 'font-size: 1rem; height: 2.25rem;'}}) }}
                    </div>
                    <a href="{{ path('app_address_new') }}" class="btn btn-fill-out btn-block mt-1">Ajouter une nouvelle adresse</a>
                </div>
                <div class="heading_s1">
                    <h4>Choisir Livraison</h4>
                    <div class="content">
                        {% if cart.data.subTotalTTC >= 80 and cart.data.subTotalTTC < 100 %}
                            <div class="d-flex">
                                <i class="fa-solid fa-triangle-exclamation mt-1 mx-2"></i>
                                <p>Il vous reste {{ 100 - cart.data.subTotalTTC  | number_format(2, '.', ',')}} € pour avoir la livraison gratuite</p>
                            </div>
                        {% endif %}
                        {{ form_widget(checkout.carrier) | replace({'[spr]': '<br>'}) | raw }}
                    </div>
                </div>
                <div class="heading_s1">
                    <h4>Plus d'information</h4>
                    <div class="form-group mb-0">
                        {{ form_widget(checkout.information) }}
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="order_review">
                    <div class="heading_s1">
                        <h4>Vos Commandes</h4>
                    </div>
                    <div class="table-responsive order_table">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Prix TTC</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for element in cart.products %}
                                    <tr>
                                        <td>
                                            {% set displayName = element.product.name|length > 50 ? element.product.name|slice(0, 50) ~ '...' : element.product.name %}
                                            {{ displayName }} <span class="product-qty"> x {{ element.quantity }}</span>
                                        </td>
                                        <td>
                                            {% set originalPrice = element.variant['price'] %}
                                            {% set discount = (element.variant['offVariant'] is defined and element.variant['offVariant'] > 0) ? (element.variant['offVariant'] / 100) : 0 %}
                                            {% set discountedPrice = originalPrice * (1 - discount) %}
                                            {{ discountedPrice | number_format(2, '.', ',') }} €
                                        </td>

                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                        <tfoot>
                            {% if cart.data.isCouponApplied %}
                                <tr>
                                    <th>Code promo appliqué :</th>
                                    <td class="product-subtotal">{{ cart.appliedCouponCode }}</td>
                                </tr>
                                <tr>
                                    <th>Réduction appliquée :</th>
                                    <td class="product-subtotal">{{ cart.data.appliedDiscountPercentage | number_format(2, '.', ',') }}%</td>
                                </tr>
                                <tr>
                                    <th>Montant de la réduction :</th>
                                    <td class="product-subtotal">- {{ cart.data.appliedDiscountAmount | number_format(2, '.', ',') }} €</td>
                                </tr>
                                <tr>
                                    <th>Total HT (après réduction) :</th>
                                    <td class="product-subtotal">{{ (cart.data.subTotalHT * (1 - cart.data.appliedDiscountPercentage / 100)) | number_format(2, '.', ',') }} €</td>
                                </tr>
                                <tr>
                                    <th>Total TVA 20% (après réduction) :</th>
                                    <td class="product-subtotal">{{ (cart.data.Taxe * (1 - cart.data.appliedDiscountPercentage / 100)) | number_format(2, '.', ',') }} €</td>
                                </tr>
                                <tr>
                                    <th>Total TTC (après réduction) :</th>
                                    <td class="product-subtotal">{{ (cart.data.subTotalTTC) | number_format(2, '.', ',') }} €</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <th>Total HT :</th>
                                    <td class="product-subtotal">{{ cart.data.subTotalHT | number_format(2, '.', ',') }} €</td>
                                </tr>
                                <tr>
                                    <th>Total TVA 20% :</th>
                                    <td class="product-subtotal">{{ cart.data.Taxe | number_format(2, '.', ',') }} €</td>
                                </tr>
                                <tr>
                                    <th>Total TTC :</th>
                                    <td class="product-subtotal">{{ cart.data.subTotalTTC | number_format(2, '.', ',') }} €</td>
                                </tr>
                            {% endif %}
                        </tfoot>




                        </table>
                    </div>
                    <div class="payment_method">
                        <div class="heading_s1">
                            <h4>Payment</h4>
                        </div>
                    </div>
                    <button type="submit" id="checkout-button" class="btn btn-fill-out btn-block">Confirmer la commande</button>
                </div>
            </div>
        </div>
        {{ form_end(checkout) }}
    </div>
</div>
{% endblock %}


{% block javascripts %}
<script>

document.addEventListener('DOMContentLoaded', function() {
    // Utilisation d'une valeur injectée par Twig pour le sous-total
    var subtotal = {{ cart.data.subTotalTTC }}; // Assurez-vous que cette valeur est en euros et non en centimes si nécessaire

    var freeDeliveryOption = document.getElementById('checkout_carrier_1');

    function updateFreeDeliveryAvailability() {
        if (subtotal >= 100) {
            freeDeliveryOption.disabled = false;
        } else {
            freeDeliveryOption.disabled = true;
            if (freeDeliveryOption.checked) {
                freeDeliveryOption.checked = false;
                // Cochez une autre option par défaut si nécessaire
                document.getElementById('checkout_carrier_2').checked = true;
            }
        }
    }

    updateFreeDeliveryAvailability(); // Initial update based on the current cart value
});
</script>
{% endblock %}
