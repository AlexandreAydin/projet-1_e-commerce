<div class="item">
    <div class="product">
        <div class="product_img">
            <a href="{{ path('app_single_product', { 'slug': product.slug }) }}">
                {% if product.images|length > 0 %}
                    {% set firstImage = product.images|first %}
                    <img src="{{ asset('images/products/' ~ firstImage.imageName) }}" 
                         alt="{{ product.name }}" />
                {% else %}
                    <img src="{{ asset('images/products/default-image.jpg') }}" 
                         alt="{{ product.name }}" />
                {% endif %}
            </a>
        </div>
        <div class="product_info">
            <h6 class="product_title">
                <a href="{{ path('app_single_product', { 'slug': product.slug }) }}">{{ product.name }}</a>
            </h6>
            <div class="product_price">
                {% set displayed = false %}
                {% for variant in product.getVariants %}
                    {% if not displayed %}
                        <span class="price">
                            {{ ((variant.price - (variant.price * variant.offVariant) / 100)) | number_format(2, ',', '.') }} €
                        </span>
                        {% if variant.offVariant is defined and variant.offVariant > 0 %}
                            <del>{{ (variant.price)|number_format(2, ',', '.') }} €</del>
                            <div class="on_sale">
                                <span>{{ variant.offVariant }}% réduction</span>
                            </div>
                        {% endif %}
                        {% set displayed = true %}
                    {% endif %}
                {% endfor %}
            </div>
            {% set currentProductRating = relatedRatings[product.id] ?? 0 %}
            <div class="rating_wrap">
                <div class="rating">
                    <div class="product_rate" style="width: {{ (currentProductRating * 20) | round(0, 'floor') }}%"></div>
                </div>
                <span class="rating_num">({{ product.rewiewsProducts | length }})</span>
            </div>
            <ul class="d-flex justify-content-between mt-2">
                <li class="add-to-cart style-none list-unstyled">
                    {% if product.quantity > 0 %}
                    {% else %}
                        <span style="font-size: 12px;">Non disponible</span>
                    {% endif %}
                </li>
            </ul>
        </div>
    </div>
</div>