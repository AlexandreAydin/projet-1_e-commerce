
{% block stylesheets %}
    {# {{ parent() }} <!-- Ensures that the parent styles are included --> #}
    <link rel="stylesheet" href="{{ asset('assets/css/_product.css') }}">
{% endblock %}




<div class="col-lg-3 col-md-4 col-6">
    <div class="product"> 
        <div class="product" onclick="location.href='{{ path('app_single_product', { 'slug': product.slug }) }}';" style="cursor: pointer;">
            <div class="product_img">
                <a href="{{ path('app_single_product', { 'slug': product.slug }) }}">
                    {% if product.images|length > 0 %}
                        {% set firstImage = product.images|first %}
                        <img src="{{ asset('images/products/' ~ firstImage.imageName) }}" alt="{{ product.name }}" width="100%" object-fit="cover" height="300" />
                    {% endif %}
                </a>
                <!-- Nouveau cœur en haut à droite -->
                <a class="add-to-wishlist {{ isInWishlist ? 'wishlist-active' : '' }}" 
                href="{{ path('wishlist_toggle', {id: product.id}) }}" 
                data-product-id="{{ product.id }}"
                onclick="event.stopPropagation();">
                    <i class="fa fa-heart"></i>
                </a>
            </div>
        </div>
        <div class="product_info">
            <h6 class="product_title">
                <a href="{{ path('app_single_product', { 'slug': product.slug }) }}">{{ product.name }}</a>
            </h6>
            <div class="product_price">
                {% set displayed = false %}
                {% for variant in product.getVariants %}
                    {% if not displayed %}
                        <span class="price">
                            {{ ((variant.price) - (variant.price  * variant.offVariant ) / 100) | number_format(2, ',', '.') }} €
                        </span>
                        {% if variant.offVariant is defined and variant.offVariant > 0 %}
                            <del>{{ (variant.price)|number_format(2, ',', '.') }} €</del>
                            <div class="on_sale">
                                <span>{{ variant.offVariant }}% réduction</span>
                            </div>
                        {% endif %}
                        {% set displayed = true %}
                    {% endif %}
                {% endfor %}
            </div>
            {% set currentProductRating = productRatings[product.id] ?? 0 %}
            <div class="rating_wrap">
                <div class="rating">
                    <div class="product_rate" style="width: {{ (currentProductRating * 20) | round(0, 'floor') }}%"></div>
                </div>
                <span class="rating_num">({{ product.rewiewsProducts | length }})</span>
            </div>
            <div class="pr_desc">
                <p>{{ product.description }}</p>
            </div>
        </div>
    </div>
</div>
